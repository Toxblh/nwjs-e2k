# NW.js 0.117.0 (Chromium 154.0.8037.58 base) on the e2k Chromium 154.0.8037.97 tree
nwjs_sdk = false
is_component_ffmpeg = false  # see args-el.gn
ffmpeg_branding = "Chrome"
proprietary_codecs = true
is_component_build = false
chrome_pgo_phase = 0
cppgc_enable_object_section_gcinfo = false
enable_linux_installer = false
exclude_unwind_tables = false  # NW.js forces true; keep the e2k Chrome value (Rust seed hits)
target_cpu = "e2k"
v8_target_cpu = "e2k"
custom_toolchain = "//build/toolchain/linux/unbundle:default"
host_toolchain = "//build/toolchain/linux/unbundle:default"
is_clang = true
clang_base_path = "/usr/lib/llvm-21.1"
clang_use_chrome_plugins = false
use_lld = false
use_sysroot = false
use_custom_libcxx = true
use_llvm_libatomic = false
is_debug = false
is_official_build = false
dcheck_always_on = false
symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0
treat_warnings_as_errors = false
fatal_linker_warnings = false
use_thin_lto = false
use_gtk = true
gtk_version = 4
ozone_platform = "x11"
ozone_platform_x11 = true
ozone_platform_wayland = true
enable_vulkan = false
angle_enable_vulkan = false
dawn_enable_vulkan = false
enable_swiftshader = false
enable_swiftshader_vulkan = false
enable_vr = false
use_vaapi = false
enable_widevine = false
rtc_use_pipewire = true
optimize_webui = false
safe_browsing_use_unrar = false
webnn_use_tflite = false
webnn_use_litert = false
build_dawn_tests = false
tint_build_unittests = false
enable_perfetto_unittests = false
enable_nocompile_tests = false
disable_fieldtrial_testing_config = true
v8_control_flow_integrity = false
enable_gwp_asan_malloc = false
enable_gwp_asan_partitionalloc = false
added_rust_stdlib_libs = [ "unicode_width" ]
use_system_libffi = true
use_dawn = false
skia_use_dawn = false
angle_enable_wgpu = false
v8_enable_webassembly = true
v8_enable_maglev = true
v8_enable_sparkplug = true
v8_enable_pointer_compression = false
v8_enable_sandbox = false
v8_enable_i18n_support = true
v8_enable_short_builtin_calls = true
