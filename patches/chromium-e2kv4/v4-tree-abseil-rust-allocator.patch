+// node26 (e2k): rust_allocator_internal on plain libc malloc, for builds without PartitionAlloc-as-malloc whose
+// Rust allocator crate is the one of the PartitionAlloc configuration (the native rustc seed only has that rlib).
+#include <stdlib.h>
+#include <string.h>
+#include <stddef.h>
+namespace rust_allocator_internal {
+static inline bool small(size_t align) { return align <= alignof(max_align_t); }
+static unsigned char* big(size_t size, size_t align) {
+  void* p = nullptr;
+  return posix_memalign(&p, align, size ? size : 1) == 0 ? static_cast<unsigned char*>(p) : nullptr;
+}
+unsigned char* alloc(size_t size, size_t align) {
+  return small(align) ? static_cast<unsigned char*>(malloc(size)) : big(size, align);
+}
+unsigned char* alloc_zeroed(size_t size, size_t align) {
+  if (small(align)) return static_cast<unsigned char*>(calloc(1, size));
+  unsigned char* p = big(size, align);
+  if (p) memset(p, 0, size);
+  return p;
+}
+void dealloc(unsigned char* p, size_t, size_t) { free(p); }
+unsigned char* realloc(unsigned char* p, size_t old_size, size_t align, size_t new_size) {
+  if (small(align)) return static_cast<unsigned char*>(::realloc(p, new_size));
+  unsigned char* n = big(new_size, align);
+  if (n) { memcpy(n, p, old_size < new_size ? old_size : new_size); free(p); }
+  return n;
+}
+}  // namespace rust_allocator_internal
