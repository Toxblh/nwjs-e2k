 chromium/v8/src/codegen/e2k/assembler-e2k.h   |   4 +
 chromium/v8/src/codegen/e2k/la_asm.h          |  58 +++++++++
 .../v8/src/codegen/e2k/macro-assembler-e2k.cc |  24 ++--
 .../backend/e2k/code-generator-e2k.cc         | 110 +++++-------------
 .../baseline/e2k/liftoff-assembler-e2k-inl.h  |  66 +++--------
 6 files changed, 130 insertions(+), 137 deletions(-)

