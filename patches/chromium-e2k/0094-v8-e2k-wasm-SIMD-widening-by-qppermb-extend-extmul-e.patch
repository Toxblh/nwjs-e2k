--- a/chromium/v8/src/codegen/e2k/assembler-e2k.h
+++ b/chromium/v8/src/codegen/e2k/assembler-e2k.h
@@ -910,6 +910,10 @@ class V8_EXPORT_PRIVATE Assembler : public AssemblerBase {
   void vpmax_s(VRegister vd, VRegister vj, VRegister vk);
