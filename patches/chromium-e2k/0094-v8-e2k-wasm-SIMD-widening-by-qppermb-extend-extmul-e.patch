diff --git a/chromium/v8/src/codegen/e2k/la_asm.h b/chromium/v8/src/codegen/e2k/la_asm.h
index f1b3df0bce..f38ce0c9d2 100644
--- a/chromium/v8/src/codegen/e2k/la_asm.h
+++ b/chromium/v8/src/codegen/e2k/la_asm.h
@@ -1229,6 +1229,45 @@ class Assembler : private e2k::Assembler {
   void vpmin_d(VRegister vd, VRegister vj, VRegister vk) { L(qpfmind(0, V(vk), V(vj), V(vd))); }
   void vpmax_d(VRegister vd, VRegister vj, VRegister vk) { L(qpfmaxd(0, V(vk), V(vj), V(vd))); }
 
+  // Widening (wasm extend_low/high, the loads with extension): the low or
+  // high half of vj (vextr: the 64 bits of rj), lanes of `size` bytes, to
+  // lanes twice as wide, signed or not; vzext: vd = 0:rj.
+  void vext(VRegister vd, VRegister vj, int size, bool sign, bool high) { ext(vd, V(vj), size, sign, high); }
+  void vextr(VRegister vd, Register rj, int size, bool sign) { ext(vd, R(rj), size, sign, false); }
+  void vzext(VRegister vd, Register rj) { L(qppackdl(0, 0, R(rj), V(vd))); }
+  // wasm extmul_low/high: the product of the lanes widened.  8 bits: both
+  // widened, qpmullh; 16: qpmullh and qpmulhh/qpmulhuh interleaved; 32:
+  // smulx/umulx on the scalar side.
+  void vextmul(VRegister vd, VRegister vj, VRegister vk, int size, bool sign, bool high) {
+    Reg a = V(vj), b = V(vk);
+    int base = high ? 8 : 0;
+    if (size == 1) {
+      if (sign) {
+        qconst(T0, idx16([=](int o) { return base + o / 2; }));
+        C(qppermb(0, a, a, T0, T2); qppermb(1, b, b, T0, T3));
+        C(qpsrah(0, T2, 8, T2); qpsrah(1, T3, 8, T3));
+      } else {
+        qconst(T0, idx16([=](int o) { return o % 2 ? 16 : base + o / 2; }));
+        qzero(T1);
+        C(qppermb(0, T1, a, T0, T2); qppermb(1, T1, b, T0, T3));
+      }
+      L(qpmullh(1, T2, T3, V(vd)));
+      return;
+    }
+    if (size == 2) {
+      if (sign) C(qpmullh(1, a, b, T0); qpmulhh(4, a, b, T1)); else C(qpmullh(1, a, b, T0); qpmulhuh(4, a, b, T1));
+      qconst(T2, idx16([=](int o) { return (o % 4 >= 2 ? 16 : 0) + (base / 2 + o / 4) * 2 + o % 2; }));
+      L(qppermb(0, T1, T0, T2, V(vd)));
+      return;
+    }
+    Alu mul = sign ? &E::smulx : &E::umulx;
+    if (high) { C(qpswitchd(0, a, T0); qpswitchd(1, b, T1)); a = T0; b = T1; }
+    C((this->*mul)(0, a, b, T2); shrd(1, a, 32, T3));
+    C(shrd(0, b, 32, T1));
+    C((this->*mul)(0, T3, T1, T3));
+    L(qppackdl(0, T3, T2, V(vd)));
+  }
+
   // ---- memory: two 64-bit halves (any alignment)
   void vld(VRegister vd, Register rj, int32_t si12) { C(ldd(0, R(rj), si12, T0); ldd(2, R(rj), si12 + 8, T1)); L(qppackdl(0, T1, T0, V(vd))); }
   void vst(VRegister vd, Register rj, int32_t si12) { C(qpswitchd(0, V(vd), T0)); L(std_(2, R(rj), si12, V(vd)); std_(5, R(rj), si12 + 8, T0)); }
@@ -1841,6 +1880,25 @@ class Assembler : private e2k::Assembler {
     C((this->*mul)(0, V(vj), V(vk), T2); (this->*mul)(1, T0, T1, T3));
     L(qppackdl(0, T3, T2, V(vd)));
   }
+  void ext(VRegister vd, Reg src, int size, bool sign, bool high) {
+    int base = high ? 8 : 0;
+    if (!sign) {
+      qconst(T0, idx16([=](int o) { return o % (2 * size) >= size ? 16 : base + o / (2 * size) * size + o % size; }));
+      qzero(T1);
+      L(qppermb(0, T1, src, T0, V(vd)));
+      return;
+    }
+    if (size == 4) {
+      qconst(T0, idx16([=](int o) { return (o % 8 >= 4 ? 16 : 0) + base + o / 8 * 4 + o % 4; }));
+      C(qpsraw(0, src, 31, T1));                 // the signs of the lanes
+      L(qppermb(0, T1, src, T0, V(vd)));
+      return;
+    }
+    // each lane twice in the wide one, then the arithmetic shift
+    qconst(T0, idx16([=](int o) { return base + o / (2 * size) * size + o % size; }));
+    C(qppermb(0, src, src, T0, T0));
+    if (size == 1) L(qpsrah(0, T0, 8, V(vd))); else L(qpsraw(0, T0, 16, V(vd)));
+  }
   void anyeqz(Alu cmpeq, bool any, CFRegister cd, VRegister vj) {
     qzero(T0);
     C((this->*cmpeq)(0, V(vj), T0, T0));
