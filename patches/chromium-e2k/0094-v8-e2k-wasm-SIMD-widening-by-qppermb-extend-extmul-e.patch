 void Assembler::vpmax_d(VRegister vd, VRegister vj, VRegister vk) { LA(vpmax_d(vd, vj, vk)); }
 
+void Assembler::vext(VRegister vd, VRegister vj, int size, bool sign, bool high) { LA(vext(vd, vj, size, sign, high)); }
+void Assembler::vextr(VRegister vd, Register rj, int size, bool sign) { LA(vextr(vd, rj, size, sign)); }
+void Assembler::vzext(VRegister vd, Register rj) { LA(vzext(vd, rj)); }
+void Assembler::vextmul(VRegister vd, VRegister vj, VRegister vk, int size, bool sign, bool high) { LA(vextmul(vd, vj, vk, size, sign, high)); }
