-    EXT_MUL_BINOP(LSXU16, vilvl_h, vmulwev_w_hu)
-    EXT_MUL_BINOP(LSXU32, vilvl_w, vmulwev_d_wu)
+    case LSXS8: vextmul(dst, src1, src2, 1, true, false); break;
+    case LSXS16: vextmul(dst, src1, src2, 2, true, false); break;
+    case LSXS32: vextmul(dst, src1, src2, 4, true, false); break;
+    case LSXU8: vextmul(dst, src1, src2, 1, false, false); break;
+    case LSXU16: vextmul(dst, src1, src2, 2, false, false); break;
+    case LSXU32: vextmul(dst, src1, src2, 4, false, false); break;
     default:
       UNREACHABLE();
   }
@@ -2597,12 +2597,12 @@ void MacroAssembler::ExtMulLow(LSXDataType type, VRegister dst, VRegister src1,
 void MacroAssembler::ExtMulHigh(LSXDataType type, VRegister dst, VRegister src1,
                                 VRegister src2) {
   switch (type) {
-    EXT_MUL_BINOP(LSXS8, vilvh_b, vmulwev_h_b)
-    EXT_MUL_BINOP(LSXS16, vilvh_h, vmulwev_w_h)
-    EXT_MUL_BINOP(LSXS32, vilvh_w, vmulwev_d_w)
-    EXT_MUL_BINOP(LSXU8, vilvh_b, vmulwev_h_bu)
-    EXT_MUL_BINOP(LSXU16, vilvh_h, vmulwev_w_hu)
-    EXT_MUL_BINOP(LSXU32, vilvh_w, vmulwev_d_wu)
+    case LSXS8: vextmul(dst, src1, src2, 1, true, true); break;
+    case LSXS16: vextmul(dst, src1, src2, 2, true, true); break;
+    case LSXS32: vextmul(dst, src1, src2, 4, true, true); break;
+    case LSXU8: vextmul(dst, src1, src2, 1, false, true); break;
+    case LSXU16: vextmul(dst, src1, src2, 2, false, true); break;
+    case LSXU32: vextmul(dst, src1, src2, 4, false, true); break;
     default:
       UNREACHABLE();
   }
