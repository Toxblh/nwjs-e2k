   switch (type) {
-    EXT_MUL_BINOP(LSXS8, vilvl_b, vmulwev_h_b)
-    EXT_MUL_BINOP(LSXS16, vilvl_h, vmulwev_w_h)
-    EXT_MUL_BINOP(LSXS32, vilvl_w, vmulwev_d_w)
