index 8621420b05..db4c60aa8b 100644
--- a/chromium/v8/src/codegen/e2k/macro-assembler-e2k.cc
+++ b/chromium/v8/src/codegen/e2k/macro-assembler-e2k.cc
@@ -3656,6 +3656,48 @@ void MacroAssembler::BranchTst(Label* L, Condition cond, Register rj,
   }
 }
 
+void MacroAssembler::CompareSubOverflow(Register result, Register r1,
+                                        const Operand& r2, bool is32) {
+  if (r2.is_reg()) {
+    if (is32) {
+      subo_w(result, r1, r2.rm());
+    } else {
+      subo_d(result, r1, r2.rm());
+    }
+  } else {
+    DCHECK(RelocInfo::IsNoInfo(r2.rmode()));
+    suboi(is32, result, r1, r2.immediate());
+  }
+}
+
+void MacroAssembler::BranchSubOverflow(Label* L, Condition cond, Register r1,
+                                       const Operand& r2, bool is32) {
+  DCHECK(cond == Condition::overflow || cond == Condition::no_overflow);
+  if (L->is_bound() ? !is_near(L, OffsetSize::kOffset16)
+                    : is_trampoline_emitted()) {
+    UseScratchRegisterScope temps(this);
+    Register scratch = temps.Acquire();
+    CompareSubOverflow(scratch, r1, r2, is32);
+    Branch(L, cond == Condition::overflow ? ne : eq, scratch, Operand(zero_reg));
+    return;
+  }
+  int32_t offset = GetOffset(L, OffsetSize::kOffset16);
+  if (!r2.is_reg()) {
+    DCHECK(RelocInfo::IsNoInfo(r2.rmode()));
+    bsuboi(is32, cond == Condition::no_overflow, r1, r2.immediate(), offset);
+  } else if (is32) {
+    if (cond == Condition::overflow) {
+      bsubo_w(r1, r2.rm(), offset);
+    } else {
+      bsubno_w(r1, r2.rm(), offset);
+    }
+  } else if (cond == Condition::overflow) {
+    bsubo(r1, r2.rm(), offset);
+  } else {
+    bsubno(r1, r2.rm(), offset);
+  }
+}
+
 void MacroAssembler::CompareTaggedAndBranch(Label* label, Condition cond,
                                             Register r1, const Operand& r2,
                                             bool need_link) {
