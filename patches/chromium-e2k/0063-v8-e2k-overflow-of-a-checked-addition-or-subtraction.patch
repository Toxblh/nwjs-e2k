   // scratch register.
   void BranchTst(Label* label, Condition cond, Register r1, const Operand& r2);
+  // Branches when r1 - r2 overflows as signed 64-bit numbers (overflow) or
+  // does not (no_overflow); is32: as 32-bit ones, of the low halves. One
+  // compare, no flag in a register. This is how the overflow of a checked
+  // addition or subtraction is told from its result: s = a + b overflowed
+  // when s - a does, d = a - b when a - d does.
+  void BranchSubOverflow(Label* label, Condition cond, Register r1,
+                         const Operand& r2, bool is32 = false);
+  // result = 1 when r1 - r2 overflows, else 0.
+  void CompareSubOverflow(Register result, Register r1, const Operand& r2,
+                          bool is32 = false);
   void Branch(Label* L, Condition cond, Register rj, RootIndex index,
               bool need_sign_extend = true);
 
