@@ -485,6 +485,18 @@ class V8_EXPORT_PRIVATE Assembler : public AssemblerBase {
   // Not LoongArch: branch on rj <cond> imm, the constant a literal of the
   // compare.
   void bcmpi(Condition cond, Register rj, int64_t imm, int32_t offset);
+  // Not LoongArch: branch when rj - rk overflows as signed 64-bit numbers
+  // (bsubo), does not (bsubno); _w: as 32-bit ones. bsuboi: rj - imm, 32 bits
+  // with `w`, the branch taken on no overflow with `negate`. rd = 1 when it
