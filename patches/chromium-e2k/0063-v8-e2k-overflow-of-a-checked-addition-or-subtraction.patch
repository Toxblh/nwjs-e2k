     br(f[cmp], negate, R(rj), imm, offset);
   }
+  // Not LoongArch: branch when rj - rk overflows as signed 64-bit numbers
+  // (bsubo) or does not (bsubno); _w: as 32-bit ones, the low halves.  One
+  // compare (cmpodb, cmposb) and no flag in a register.  It tells the
+  // overflow of an addition or a subtraction from the result: s = a + b
+  // overflowed when s - a does (s - a is then b plus or minus 2^64), d = a - b
+  // when a - d does (ideas/88-smi-ovf).  bsuboi: with a constant.
+  void bsubo(Register rj, Register rk, int32_t offset) { br(&E::cmpodb, false, R(rj), R(rk), offset); }
+  void bsubno(Register rj, Register rk, int32_t offset) { br(&E::cmpodb, true, R(rj), R(rk), offset); }
+  void bsubo_w(Register rj, Register rk, int32_t offset) { br(&E::cmposb, false, R(rj), R(rk), offset); }
+  void bsubno_w(Register rj, Register rk, int32_t offset) { br(&E::cmposb, true, R(rj), R(rk), offset); }
+  void bsuboi(bool w, bool negate, Register rj, int64_t imm, int32_t offset) {
+    if (w) br(&E::cmposb, negate, R(rj), int64_t(int32_t(imm)), offset); else br(&E::cmpodb, negate, R(rj), imm, offset);
+  }
   void bceqz(CFRegister cj, int32_t offset) { brc(~P(cj), offset); }
   void bcnez(CFRegister cj, int32_t offset) { brc(P(cj), offset); }
   // pc = rj + offset instructions, rd = address of the next instruction,
@@ -500,6 +513,12 @@ class Assembler : private e2k::Assembler {
   // rd = (rj & rk) == 0, (rj & mask) == 0.
   void tstz(Register rd, Register rj, Register rk) { set(&E::cmpandedb, rd, R(rj), R(rk)); }
   void tstzi(Register rd, Register rj, int64_t mask) { set(&E::cmpandedb, rd, R(rj), mask); }
+  // Not LoongArch: rd = rj - rk overflows as signed 64-bit (_w: 32-bit) numbers.
+  void subo_d(Register rd, Register rj, Register rk) { set(&E::cmpodb, rd, R(rj), R(rk)); }
+  void subo_w(Register rd, Register rj, Register rk) { set(&E::cmposb, rd, R(rj), R(rk)); }
+  void suboi(bool w, Register rd, Register rj, int64_t imm) {
+    if (w) set(&E::cmposb, rd, R(rj), int64_t(int32_t(imm))); else set(&E::cmpodb, rd, R(rj), imm);
+  }
   void tstnz(Register rd, Register rj, Register rk) { C(cmpandedb(0, R(rj), R(rk), PT0)); L(merged(0, 1, 0, D(rd), PT0)); }
   void tstnzi(Register rd, Register rj, int64_t mask) { C(cmpandedb(0, R(rj), mask, PT0)); L(merged(0, 1, 0, D(rd), PT0)); }
 
