+  void bsubno_w(Register rj, Register rk, int32_t offset);
+  void bsuboi(bool w, bool negate, Register rj, int64_t imm, int32_t offset);
+  void subo_d(Register rd, Register rj, Register rk);
+  void subo_w(Register rd, Register rj, Register rk);
+  void suboi(bool w, Register rd, Register rj, int64_t imm);
