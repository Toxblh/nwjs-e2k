+enum {
+  kInstructions, kOwn, kCommands, kJoined, kBytes,
+  kStartOpen, kStartAsked, kStartBlocked, kStartMoved,  // of all instructions
+  kLostAsked, kLostBlocked, kLostMoved,  // of those that could have joined
+  kNumStats
+};
+std::atomic<long> stats[kNumStats];
+int stats_level = 0;
+base::Mutex* lost_mutex = nullptr;
+std::map<std::array<void*, 3>, long>* lost = nullptr;
