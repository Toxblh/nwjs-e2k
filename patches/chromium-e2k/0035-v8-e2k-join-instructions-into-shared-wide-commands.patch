+          n[kBytes] / kInstrSize, double(n[kInstructions]) / n[kCommands],
+          double(n[kInstructions]) * kInstrSize / n[kBytes], n[kStartOpen],
+          n[kStartAsked], n[kStartBlocked], n[kStartMoved], n[kLostAsked],
+          n[kLostBlocked], n[kLostMoved]);
+  if (!lost) return;
+  std::vector<std::pair<long, std::array<void*, 3>>> top;
+  for (auto& e : *lost) top.push_back({e.second, e.first});
+  std::sort(top.begin(), top.end(), std::greater<>());
+  fprintf(stderr, "e2k fuse: PrintStats is at %p\n",
+          reinterpret_cast<void*>(&PrintStats));
+  for (size_t i = 0; i < top.size() && i < 60; i++) {
+    fprintf(stderr, "e2k fuse: %8ld %p %p %p\n", top[i].first,
+            top[i].second[0], top[i].second[1], top[i].second[2]);
