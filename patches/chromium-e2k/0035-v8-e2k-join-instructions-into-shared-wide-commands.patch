-la::Assembler& Scratch() {
+struct Layer {
+  la::Assembler la;
+  const Assembler* owner = nullptr;
+  int base = 0;     // pc offset of the layer's offset 0
+  int settled = 0;  // layer offset the current instruction may rewrite from
+  int start = 0;    // how the current instruction found the code: a kStart*
+  la::Assembler::Counts counted = {0, 0, 0, 0, 0};
