+  // ---- joining operations to the command written last ----------------------
+  // join(at) takes back the command that end() wrote at offset `at` (nothing
+  // else was built since).  Operations given after it become part of that
+  // command if that keeps the meaning "the old command, then these": they
+  // must not read a register or a predicate the command writes (all
+  // operations of a command read the state before it), must not write one it
+  // writes, must not touch memory after its store; a write to what the
+  // command only reads is fine.  The channel an operation names is a wish:
+  // it gets any free channel it can run in, an operation placed earlier
+  // moving aside if that helps; sm(), when() and MERGE follow.  When it does
+  // not work out joined() is false and the state is garbage: put a saved
+  // Command back with reopen() and end().
+  void join(size_t at) {
+    reopen(at);
+    for (int i = 0; i < 4; i++) { def_[i] |= gdef_[i]; gdef_[i] = 0; }
+    pdef_ |= gpdef_; gpdef_ = 0; store_ |= gstore_; gstore_ = false;
+    memset(map_, -1, sizeof map_); join_ = true; bad_ = false;
+  }
+  bool joined() const { return !bad_ && fits(); }
+  // A command with a control transfer (the code after it may be entered from
+  // elsewhere), a CS1 syllable (window, call, mas, wait) or a write to a
+  // state register takes nothing more.
+  bool joinable() const { return !alone_ && !has_ss_ && !has_cs1_; }
+  // The code is cut at `at` and the current state is the command to write there.
