+void PrintStats() {
+  long n[kNumStats];
+  for (int i = 0; i < kNumStats; i++) n[i] = stats[i].load();
+  if (!n[kCommands]) return;
+  fprintf(stderr,
+          "e2k fuse: %ld instructions (%ld with slots of their own), %ld "
+          "commands (%ld joins), %ld slots: %.2f per command, %.2f per slot\n"
