-void Assembler::EmitSlots(const uint8_t* code, int size) {
-  // Instructions and labels sit on slot boundaries: branch offsets count
-  // slots. Data emitted before (jump tables) is padded.
-  while (pc_offset() & (kInstrSize - 1)) db(0);
+la::Assembler& Assembler::OpenSlots() {
+  // Data emitted before (jump tables) is padded up to a slot.
+  while ((pc_ - buffer_start_) & (kInstrSize - 1)) db(0);
+  Layer& l = TheLayer();
+  int pos = static_cast<int>(pc_ - buffer_start_);
+  bool blocked =
+      is_trampoline_pool_blocked() || pos < no_trampoline_pool_before_;
+  bool moved =
+      l.owner != this || l.base + static_cast<int>(l.la.pc_offset()) != pos;
+  if (!slot_open_ || blocked || moved) {
+    l.la.clear();
+    l.owner = this;
+    l.base = pos;
+  }
+  l.start = blocked      ? kStartBlocked
+            : moved      ? kStartMoved
+            : slot_open_ ? kStartOpen
+                         : kStartAsked;
+  l.settled = static_cast<int>(l.la.settled());
+  return l.la;
+}
+
+void Assembler::EmitSlots(const la::Assembler& la) {
+  Layer& l = TheLayer();
+  int size = static_cast<int>(la.pc_offset()) - l.settled;
   if (!is_buffer_growth_blocked()) {
     while (buffer_space() <= kGap + size) GrowBuffer();
   }
-  memcpy(pc_, code, size);
+  pc_ = buffer_start_ + l.base + l.settled;
+  memcpy(pc_, la.code().data() + l.settled, size);
   pc_ += size;
+  slot_open_ = !is_trampoline_pool_blocked() &&
+               pc_ - buffer_start_ >= no_trampoline_pool_before_;
+  if (stats_level) {
+    const la::Assembler::Counts& c = la.counts();
+    bool own = c.own != l.counted.own;
+    stats[kInstructions] += c.instructions - l.counted.instructions;
+    stats[kOwn] += own;
+    stats[kCommands] += c.commands - l.counted.commands;
+    stats[kJoined] += c.joined - l.counted.joined;
+    stats[kBytes] += c.bytes - l.counted.bytes;
+    l.counted = c;
+    stats[l.start]++;
+    if (!own && l.start != kStartOpen) {
+      stats[l.start - kStartAsked + kLostAsked]++;
+      if (lost && l.start == kStartAsked) {
+        // Frames 0 and 1 are this function and the instruction.
+        void* frames[5] = {};
+        backtrace(frames, 5);
+        base::MutexGuard guard(lost_mutex);
+        (*lost)[{frames[2], frames[3], frames[4]}]++;
+      }
+    }
+  }
 }
 
