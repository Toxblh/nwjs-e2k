index f29ad297c7..ef15a5d351 100644
--- a/chromium/v8/src/codegen/e2k/assembler-e2k.cc
+++ b/chromium/v8/src/codegen/e2k/assembler-e2k.cc
@@ -33,14 +33,15 @@ namespace v8 {
 namespace internal {
 
 bool CpuFeatures::SupportsSimd128() {
-  // The 128-bit instructions of the backend are still those of LoongArch
-  // (LSX), which the assembler turns into a trap: WebAssembly modules that
-  // use simd128 are refused.
-  return false;
+  // The 128-bit instructions of the backend (LoongArch LSX) are made of the
+  // qp operations of e2k-v5 by the layer (la_asm.h), which every target of
+  // this port has.
+  return true;
 }
 
 void CpuFeatures::ProbeImpl(bool cross_compile) {
   supported_.Add(FPU);
+  supported_.Add(LSX);
 
