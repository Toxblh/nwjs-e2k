 chromium/v8/src/codegen/e2k/e2k_asm.h        |   22 +
 chromium/v8/src/codegen/e2k/la_asm.h         |  750 ++++++-
 chromium/v8/src/codegen/e2k/opcodes-qp.inc   |  187 ++
 4 files changed, 1633 insertions(+), 1354 deletions(-)
 create mode 100644 chromium/v8/src/codegen/e2k/opcodes-qp.inc

