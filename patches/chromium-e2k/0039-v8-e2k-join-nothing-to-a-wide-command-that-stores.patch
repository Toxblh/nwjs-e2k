From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Anton Palgunov <toxblh@gmail.com>
Date: Tue, 13 Oct 2026 04:39:32 +0100
Subject: [PATCH 39/99] v8: e2k: join nothing to a wide command that stores

Measured under TurboFan: alloc 74 -> 64 ms, props 231 -> 191 ms. The
embedded blob is 12.5 MB.
---
 chromium/v8/src/codegen/e2k/la_asm.h | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/chromium/v8/src/codegen/e2k/la_asm.h b/chromium/v8/src/codegen/e2k/la_asm.h
index 16c4591fca..69d3008980 100644
--- a/chromium/v8/src/codegen/e2k/la_asm.h
+++ b/chromium/v8/src/codegen/e2k/la_asm.h
@@ -595,10 +595,11 @@ class Assembler : private e2k::Assembler {
     finish();
     return true;
   }
-  // Nothing joins a command that loads: measured on fib under TurboFan,
-  // 237 ms with such joins, 225 without, 224 with no joins at all.
+  // Nothing joins a command that loads or stores.  Measured under TurboFan:
+  // fib 237 ms with joins to loads, 225 without (224 with no joins at all);
+  // alloc 74 ms with joins to stores, 64 without, props 231 and 191.
   bool takes() const {
-    for (int ch = 0; ch < 6; ch++) if ((als_mask_ >> ch & 1) && mem_[ch] == 1) return false;
+    for (int ch = 0; ch < 6; ch++) if ((als_mask_ >> ch & 1) && mem_[ch]) return false;
     return joinable();
   }
   void finish() {
