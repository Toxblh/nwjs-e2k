+inline void MaglevAssembler::StoreField(MemOperand operand, Register value,
+                                        int size) {
+  DCHECK(size == 1 || size == 2 || size == 4);
+  if (size == 1) {
+    St_b(value, operand);
+  } else if (size == 2) {
+    St_h(value, operand);
+  } else {
+    DCHECK_EQ(size, 4);
+    St_w(value, operand);
+  }
+}
