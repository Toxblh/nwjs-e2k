+#define DEF_SHIFT_BINOP(Instruction, opcode_reg, opcode_imm)        \
+  void Instruction::SetValueLocationConstraints() {                 \
+    UseRegister(LeftInput());                                       \
+    if (TryGetInt32ConstantInput(kRightIndex)) {                    \
+      UseAny(RightInput());                                         \
+    } else {                                                        \
+      UseRegister(RightInput());                                    \
