+    Register out = ToRegister(result());                               \
+    if (!RightInput().operand().IsRegister()) {                        \
+      auto right_const = TryGetInt32ConstantInput(kRightIndex);        \
+      DCHECK(right_const);                                             \
+      __ opcode(out, left, Operand(*right_const));                     \
+    } else {                                                           \
+      Register right = ToRegister(RightInput());                       \
