+inline void MaglevAssembler::ReverseByteOrder(Register value, int size) {
+  if (size == 2) {
+    revb_2h(value, value);
+    ext_w_h(value, value);
+  } else if (size == 4) {
+    ByteSwap(value, value, 4);
+  } else {
+    DCHECK_EQ(size, 1);
+  }
+}
