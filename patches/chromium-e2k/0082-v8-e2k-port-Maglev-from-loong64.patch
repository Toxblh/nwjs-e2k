+#define DEF_BITWISE_BINOP(Instruction, opcode)                         \
+  void Instruction::SetValueLocationConstraints() {                    \
+    UseRegister(LeftInput());                                          \
+    if (TryGetLogicalImmediateInt32ConstantInput(this, kRightIndex)) { \
+      UseAny(RightInput());                                            \
