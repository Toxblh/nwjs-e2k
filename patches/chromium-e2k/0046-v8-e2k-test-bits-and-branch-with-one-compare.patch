+++ b/chromium/v8/src/codegen/e2k/macro-assembler-e2k.cc
@@ -3531,6 +3531,32 @@ void MacroAssembler::BranchShort(Label* L, Condition cond, Register rj,
   USE(result);
 }
 
+void MacroAssembler::BranchTst(Label* L, Condition cond, Register rj,
+                               const Operand& rk) {
+  DCHECK(cond == eq || cond == ne);
+  if ((L->is_bound() ? !is_near(L, OffsetSize::kOffset16)
+                     : is_trampoline_emitted()) ||
+      (!rk.is_reg() && !RelocInfo::IsNoInfo(rk.rmode()))) {
+    UseScratchRegisterScope temps(this);
+    Register scratch = temps.Acquire();
+    And(scratch, rj, rk);
+    Branch(L, cond, scratch, Operand(zero_reg));
+    return;
+  }
+  int32_t offset = GetOffset(L, OffsetSize::kOffset16);
+  if (rk.is_reg()) {
+    if (cond == eq) {
+      bteqz(rj, rk.rm(), offset);
+    } else {
+      btnez(rj, rk.rm(), offset);
+    }
+  } else if (cond == eq) {
+    bteqzi(rj, rk.immediate(), offset);
+  } else {
+    btnezi(rj, rk.immediate(), offset);
+  }
+}
+
