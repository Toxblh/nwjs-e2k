   void bgeu(Register rj, Register rd, int32_t offset) { br(&E::cmpbdb, true, R(rj), R(rd), offset); }
   void beqz(Register rj, int32_t offset) { br(&E::cmpedb, false, R(rj), 0, offset); }
   void bnez(Register rj, int32_t offset) { br(&E::cmpedb, true, R(rj), 0, offset); }
+  // Not LoongArch: branch when rj & rk (or a constant) is zero, is not zero.
+  // One compare (cmpandedb) where LoongArch needs `and` into a scratch
+  // register and a branch on it; its result has no register to wait for.
+  void bteqz(Register rj, Register rk, int32_t offset) { br(&E::cmpandedb, false, R(rj), R(rk), offset); }
+  void btnez(Register rj, Register rk, int32_t offset) { br(&E::cmpandedb, true, R(rj), R(rk), offset); }
+  void bteqzi(Register rj, int64_t mask, int32_t offset) { br(&E::cmpandedb, false, R(rj), mask, offset); }
+  void btnezi(Register rj, int64_t mask, int32_t offset) { br(&E::cmpandedb, true, R(rj), mask, offset); }
   void bceqz(CFRegister cj, int32_t offset) { brc(~P(cj), offset); }
