+
+void MacroAssembler::SelectCmp(Register result, Condition cond, Register lhs,
+                               const Operand& rhs, Register v_true,
+                               Register v_false) {
+  UseScratchRegisterScope temps(this);
+  Register r = no_reg;
+  if (rhs.is_reg()) {
+    r = rhs.rm();
+  } else if (rhs.immediate() == 0 && RelocInfo::IsNoInfo(rhs.rmode())) {
+    r = zero_reg;
+  } else {
+    r = temps.Acquire();
+    DCHECK(!AreAliased(r, lhs, v_true, v_false));
+    li(r, rhs);
+  }
+  switch (cond) {
+    case eq:
+      seleq(result, lhs, r, v_true, v_false);
+      break;
+    case ne:
+      seleq(result, lhs, r, v_false, v_true);
+      break;
+    case less:
+      sellt(result, lhs, r, v_true, v_false);
+      break;
+    case greater_equal:
+      sellt(result, lhs, r, v_false, v_true);
+      break;
+    case greater:
+      sellt(result, r, lhs, v_true, v_false);
+      break;
+    case less_equal:
+      sellt(result, r, lhs, v_false, v_true);
+      break;
+    case Uless:
+      selltu(result, lhs, r, v_true, v_false);
+      break;
+    case Ugreater_equal:
+      selltu(result, lhs, r, v_false, v_true);
+      break;
+    case Ugreater:
+      selltu(result, r, lhs, v_true, v_false);
+      break;
+    case Uless_equal:
+      selltu(result, r, lhs, v_false, v_true);
+      break;
+    default:
+      UNREACHABLE();
+  }
+}
+
+void MacroAssembler::SelectTst(Register result, Condition cond, Register lhs,
+                               const Operand& rhs, Register v_true,
+                               Register v_false) {
+  DCHECK(cond == eq || cond == ne);
+  if (cond == ne) std::swap(v_true, v_false);
+  if (rhs.is_reg()) {
+    seltstz(result, lhs, rhs.rm(), v_true, v_false);
+  } else if (RelocInfo::IsNoInfo(rhs.rmode())) {
+    seltstzi(result, lhs, rhs.immediate(), v_true, v_false);
   } else {
     UseScratchRegisterScope temps(this);
     Register scratch = temps.Acquire();
-    maskeqz(scratch, v_true, cond);
-    masknez(result, v_false, cond);
-    or_(result, scratch, result);
+    li(scratch, rhs);
+    seltstz(result, lhs, scratch, v_true, v_false);
+  }
+}
+
+void MacroAssembler::CompareTst(Condition cond, Register result, Register lhs,
+                                const Operand& rhs) {
+  DCHECK(cond == eq || cond == ne);
+  if (rhs.is_reg()) {
+    if (cond == eq) {
+      tstz(result, lhs, rhs.rm());
+    } else {
+      tstnz(result, lhs, rhs.rm());
+    }
+  } else if (RelocInfo::IsNoInfo(rhs.rmode())) {
+    if (cond == eq) {
+      tstzi(result, lhs, rhs.immediate());
+    } else {
+      tstnzi(result, lhs, rhs.immediate());
+    }
+  } else {
+    UseScratchRegisterScope temps(this);
+    Register scratch = temps.Acquire();
+    And(scratch, lhs, rhs);
+    if (cond == eq) {
+      Sltu(result, scratch, 1);
+    } else {
+      Sltu(result, zero_reg, scratch);
+    }
   }
 }
 
