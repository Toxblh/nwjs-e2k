+#elif V8_TARGET_ARCH_E2K
+// The instructions come from the assembler (Assembler::WasmJumpSlot and the
+// two functions after it): an instruction is a slot of kInstrSize bytes of
+// e2k wide commands, there is no fixed word to put a field into.
+void JumpTableAssembler::EmitLazyCompileJumpSlot(uint32_t func_index,
+                                                 Address lazy_compile_target) {
+  uint8_t code[kLazyCompileTableSlotSize];
+  Assembler::WasmLazyCompileSlot(
+      code, func_index, static_cast<int64_t>(lazy_compile_target - pc_));
+  for (int i = 0; i < kLazyCompileTableSlotSize; i += 8) {
+    emit<uint64_t>(base::ReadUnalignedValue<uint64_t>(
+        reinterpret_cast<Address>(code + i)));
+  }
+}
+
+bool JumpTableAssembler::EmitJumpSlot(Address target) {
+  int64_t offset = static_cast<int64_t>(target - pc_);
+  if (!Assembler::IsWasmJumpOffset(offset)) return false;
+  uint8_t code[kJumpTableSlotSize];
+  Assembler::WasmJumpSlot(code, offset);
+  // This function also patches slots that other threads may be running.
+  // Only the displacement of the branch differs between two jump slots: one
+  // aligned 32-bit word.
+  for (int i = 0; i < kJumpTableSlotSize; i += 4) {
+    emit<uint32_t>(base::ReadUnalignedValue<uint32_t>(
+                       reinterpret_cast<Address>(code + i)),
+                   kRelaxedStore);
+  }
+  return true;
+}
+
+void JumpTableAssembler::EmitFarJumpSlot(Address target) {
+  uint8_t code[kFarJumpTableSlotSize];
+  Assembler::WasmFarJumpSlot(code, target);
+  for (int i = 0; i < kFarJumpTableSlotSize; i += 8) {
+    emit<uint64_t>(base::ReadUnalignedValue<uint64_t>(
+        reinterpret_cast<Address>(code + i)));
+  }
+}
+
+// static
+void JumpTableAssembler::PatchFarJumpSlot(WritableJitAllocation& jit_allocation,
+                                          Address slot, Address target) {
+  // The target is the 64-bit literal that ends the first instruction: one
+  // aligned machine word, written at once.
+  uint8_t code[kFarJumpTableSlotSize];
+  Assembler::WasmFarJumpSlot(code, target);
+  Address literal = slot + kInstrSize - kSystemPointerSize;
+  DCHECK(IsAligned(literal, kSystemPointerSize));
+  jit_allocation.WriteValue(
+      literal,
+      base::ReadUnalignedValue<Address>(reinterpret_cast<Address>(
+          code + kInstrSize - kSystemPointerSize)),
+      kRelaxedStore);
+}
+
+void JumpTableAssembler::SkipUntil(int offset) {
+  // On this platform the jump table is not zapped with valid instructions, so
+  // skipping over bytes is not allowed.
+  DCHECK_EQ(offset, pc_offset());
+}
