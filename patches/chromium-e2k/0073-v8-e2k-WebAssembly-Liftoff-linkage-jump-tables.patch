@@ -1148,6 +1144,48 @@ void Assembler::TailCallC(int arg, int32_t offset) {
   LA(tail_c(arg, offset));
 }
 void Assembler::li64(Register rd, int64_t imm) { LA(li64(rd, imm)); }
+
+// A layer of its own is plain: every instruction keeps its slots.
+bool Assembler::IsWasmJumpOffset(int64_t offset) {
+  return is_intn(offset, 30) && (offset & 7) == 0;
+}
+
+void Assembler::WasmJumpSlot(uint8_t* slot, int64_t offset) {
+  static const std::array<uint8_t, kInstrSize> model = [] {
+    la::Assembler a;
+    a.b(0);
+    CHECK_EQ(a.pc_offset(), kInstrSize);
+    std::array<uint8_t, kInstrSize> code;
+    memcpy(code.data(), a.code().data(), kInstrSize);
+    return code;
+  }();
+  memcpy(slot, model.data(), kInstrSize);
+  la::Assembler::set_branch_target_at(slot, offset);
+}
+
+void Assembler::WasmFarJumpSlot(uint8_t* slot, Address target) {
+  static const std::array<uint8_t, 2 * kInstrSize> model = [] {
+    la::Assembler a;
+    a.li64(t7, 0);
+    a.jirl(zero_reg, t7, 0);
+    CHECK_EQ(a.pc_offset(), 2 * kInstrSize);
+    std::array<uint8_t, 2 * kInstrSize> code;
+    memcpy(code.data(), a.code().data(), 2 * kInstrSize);
+    return code;
+  }();
+  memcpy(slot, model.data(), 2 * kInstrSize);
+  la::Assembler::set_li64_at(slot, target);
+}
+
+void Assembler::WasmLazyCompileSlot(uint8_t* slot, uint32_t func_index,
+                                    int64_t offset) {
+  la::Assembler a;
+  a.li(kWasmCompileLazyFuncIndexRegister, func_index);
+  a.b(0);
+  CHECK_EQ(a.pc_offset(), 2 * kInstrSize);
+  memcpy(slot, a.code().data(), 2 * kInstrSize);
+  la::Assembler::set_branch_target_at(slot + kInstrSize, offset - kInstrSize);
+}
 void Assembler::li(Register rd, int64_t imm) { LA(li(rd, imm)); }
 void Assembler::maxi_d(Register rd, Register rj, int32_t imm) {
   LA(maxi_d(rd, rj, imm));
