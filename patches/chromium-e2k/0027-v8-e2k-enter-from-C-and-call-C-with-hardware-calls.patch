From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Anton Palgunov <toxblh@gmail.com>
Date: Mon, 12 Oct 2026 20:30:41 +0100
Subject: [PATCH 27/99] v8: e2k: enter from C++ and call C++ with hardware
 calls

JSEntry opens the register window all generated code runs in and returns
with the hardware return. C functions are called through Assembler::CallC,
which passes the arguments in the top registers of the window and lowers
the hardware stack pointer below sp. li is always one instruction. The
float to int64 conversions clear the sticky flags before reading them.
---
 chromium/v8/src/builtins/e2k/builtins-e2k.cc  |  16 +-
 .../v8/src/codegen/e2k/macro-assembler-e2k.cc | 175 ++++--------------
 .../v8/src/codegen/e2k/macro-assembler-e2k.h  |   4 +-
 .../backend/e2k/code-generator-e2k.cc         |   4 +
 4 files changed, 56 insertions(+), 143 deletions(-)

diff --git a/chromium/v8/src/builtins/e2k/builtins-e2k.cc b/chromium/v8/src/builtins/e2k/builtins-e2k.cc
index 2ea6095f35..e6f6619d60 100644
--- a/chromium/v8/src/builtins/e2k/builtins-e2k.cc
+++ b/chromium/v8/src/builtins/e2k/builtins-e2k.cc
@@ -567,6 +567,14 @@ void Generate_JSEntryVariant(MacroAssembler* masm, StackFrame::Type type,
     //   a0: root register value
     //   a1: microtask_queue
 
+    // Called by C++ with a hardware call: open the register window all
+    // generated code runs in, move the arguments to a0.., set sp. The
+    // caller's registers are in its own window, so the pushes below save
+    // nothing of value; they stay to keep the layout of the entry frame.
+    // Arguments not passed by the caller must not be read: see CallC.
+    __ EnterFromC(entry_trampoline == Builtin::kRunMicrotasksTrampoline ? 2
+                                                                         : 6);
+
     // Save callee saved registers on the stack.
     __ MultiPush(kCalleeSaved | ra);
 
@@ -730,8 +738,8 @@ void Generate_JSEntryVariant(MacroAssembler* masm, StackFrame::Type type,
 
   // Restore callee saved registers from the stack.
   __ MultiPop(kCalleeSaved | ra);
-  // Return.
-  __ Jump(ra);
+  // Return to C++: the hardware return, with a0 as the result.
+  __ ReturnToC();
 }
 
 }  // namespace
@@ -4382,7 +4390,7 @@ void Builtins::Generate_CEntry(MacroAssembler* masm, int result_size,
   DCHECK_EQ(kCArgRegs[1], argv);
   __ li(kCArgRegs[2], ER::isolate_address());
 
-  __ StoreReturnAddressAndCall(target_fun);
+  __ StoreReturnAddressAndCall(target_fun, result_size);
 
   // Result returned in a0 or a1:a0 - do not destroy these registers!
   // Check result for exception sentinel.
@@ -4874,7 +4882,7 @@ void Builtins::Generate_DirectCEntry(MacroAssembler* masm) {
   // making the call GC safe. The irregexp backend relies on this.
 
   __ St_d(ra, MemOperand(sp, 0));  // Store the return address.
-  __ Call(t5);                     // Call the C++ function.
+  __ CallC(t5, kRegisterPassedArguments, 0, 1);  // Call the C++ function.
   __ Ld_d(ra, MemOperand(sp, 0));  // Return to calling code.
 
   // TODO(LOONG_dev): E2K Check this assert.
