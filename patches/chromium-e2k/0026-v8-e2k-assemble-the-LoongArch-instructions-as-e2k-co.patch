+// Every LoongArch instruction is assembled as e2k code by la::Assembler
+// (la_asm.h) into a scratch buffer and appended to the code: one 32-byte slot
+// per instruction, two for a few of them.
+namespace {
+la::Assembler& Scratch() {
+  // One per thread, never destroyed.
+  static thread_local la::Assembler* assembler = new la::Assembler;
+  assembler->clear();
+  return *assembler;
+}
+}  // namespace
+
+#define LA(call)                                                      \
+  do {                                                                \
+    la::Assembler& la_scratch = Scratch();                            \
+    la_scratch.call;                                                  \
+    EmitSlots(la_scratch.code().data(),                               \
+              static_cast<int>(la_scratch.code().size()));            \
+  } while (false)
+
+void Assembler::EmitSlots(const uint8_t* code, int size) {
+  // Instructions and labels sit on slot boundaries: branch offsets count
+  // slots. Data emitted before (jump tables) is padded.
+  while (pc_offset() & (kInstrSize - 1)) db(0);
+  if (!is_buffer_growth_blocked()) {
+    while (buffer_space() <= kGap + size) GrowBuffer();
+  }
+  memcpy(pc_, code, size);
+  pc_ += size;
+}
+
+void Assembler::EnterFromC(int num_args) { LA(enter(num_args)); }
+void Assembler::ReturnToC() { LA(leave()); }
+void Assembler::CallC(Register target, int num_gp, int num_fp,
+                      int num_results) {
+  // ponytail: the first eight arguments only, integer ones first; the rest
+  // are on the stack at sp, where the callee expects them.
+  num_gp = std::min(num_gp, 8);
+  num_fp = std::min(num_fp, 8 - num_gp);
+  LA(ccall(target, num_gp, num_fp, num_results));
+}
