+
+void MacroAssembler::St_b(Register rd, const MemOperand& rj, int* trap_pc) {
+  MemOperand source = rj;
+  AdjustBaseAndOffset(&source);
+  if (trap_pc != NULL) *trap_pc = pc_offset();
