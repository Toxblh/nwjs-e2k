+  if (value_bits == kImm1Bits) {
+    imm = value & kImm1Mask;
+  } else if (value_bits == kImm2Bits) {
+    imm = value & kImm2Mask;
+  } else if (value_bits == kImm3Bits) {
+    imm = value & kImm3Mask;
+  }
+  Instr instr = opcode | imm << kRkShift | (rj.code() << kRjShift) | vd.code();
+  emit(instr);
