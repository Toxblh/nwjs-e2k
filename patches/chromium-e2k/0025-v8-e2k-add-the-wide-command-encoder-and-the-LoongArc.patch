+// LoongArch64 instruction set on top of e2k wide commands: the bottom layer of
+// the native V8 backend for e2k (see ../DESIGN.md).
+//
+// The class has the methods of V8's loong64 `Assembler` with the same operand
+// order and the semantics of V8's loong64 simulator.  Every instruction takes
+// one slot of kSlot bytes (a few take two, see NOTES.md): one or more wide
+// commands, the last one stretched with zero words up to the slot boundary.
+//
+//   LA r0..r31    %r0..%r31    (%r0 must hold 0: the entry code sets it, the
+//                               layer never writes it)
+//   LA f0..f31    %r32..%r63
+//   LA fcc0..7    %pred0..%pred7
+//   scratch       %b[0]..%b[3] (= %r64..%r67 with setbn rbs = 32), %pred8, %pred9
+//   C arguments   %b[4]..%b[11] (= %r68..%r75), the top of the window: see ccall
+//                 %ctpr1 (jumps and calls), %ctpr2 (return)
+//
+// Code distances are counted in instructions (slots), as in V8: branch
+// offsets, the offset of jirl and the operand of pcaddi.  pc is the address
+// of the slot.  The code is position independent.
+#ifndef LA_ASM_H_
+#define LA_ASM_H_
+
+#ifdef LA_ASM_V8
+#include "src/codegen/e2k/e2k_asm.h"
+#else
+#include "../asm/e2k_asm.h"
+#endif
+
+namespace la {
+
+constexpr int kSlot = 32;
+constexpr uint32_t kFCSRExceptionMasks = 0x1f80;   // all exceptions masked: always set by movgr2fcsr
+
+#ifdef LA_ASM_V8
+// Inside V8 the registers, conditions and FCSR constants are V8's
+// (register-e2k.h, constants-e2k.h).
+using namespace v8::internal;
+typedef DoubleRegister FPURegister;
+#else
+constexpr int kInstrSize = kSlot;
+
+class Register {
+ public:
+  constexpr explicit Register(int code) : code_(code) {}
+  constexpr int code() const { return code_; }
+  constexpr bool operator==(Register o) const { return code_ == o.code_; }
+  constexpr bool operator!=(Register o) const { return code_ != o.code_; }
+ private:
+  int code_;
+};
+class FPURegister {
+ public:
+  constexpr explicit FPURegister(int code) : code_(code) {}
+  constexpr int code() const { return code_; }
+ private:
+  int code_;
+};
+enum CFRegister { FCC0, FCC1, FCC2, FCC3, FCC4, FCC5, FCC6, FCC7 };
+struct FPUControlRegister { int code; };
+constexpr FPUControlRegister FCSR0{0}, FCSR1{1}, FCSR2{2}, FCSR3{3};
+
+constexpr Register zero_reg(0), ra(1), tp(2), sp(3), a0(4), a1(5), a2(6), a3(7), a4(8), a5(9), a6(10), a7(11),
+    t0(12), t1(13), t2(14), t3(15), t4(16), t5(17), t6(18), t7(19), t8(20), x_reg(21), fp(22),
+    s0(23), s1(24), s2(25), s3(26), s4(27), s5(28), s6(29), s7(30), s8(31);
+constexpr FPURegister f0(0), f1(1), f2(2), f3(3), f4(4), f5(5), f6(6), f7(7), f8(8), f9(9), f10(10), f11(11),
+    f12(12), f13(13), f14(14), f15(15), f16(16), f17(17), f18(18), f19(19), f20(20), f21(21), f22(22), f23(23),
+    f24(24), f25(25), f26(26), f27(27), f28(28), f29(29), f30(30), f31(31);
+
+enum FPUCondition {
+  CAF = 0x00, SAF = 0x01, CLT = 0x02, SLT_ = 0x03, CEQ = 0x04, SEQ = 0x05, CLE = 0x06, SLE = 0x07,
+  CUN = 0x08, SUN = 0x09, CULT = 0x0a, SULT = 0x0b, CUEQ = 0x0c, SUEQ = 0x0d, CULE = 0x0e, SULE = 0x0f,
+  CNE = 0x10, SNE = 0x11, COR = 0x14, SOR = 0x15, CUNE = 0x18, SUNE = 0x19,
+};
+
+// FCSR as seen through movfcsr2gr/movgr2fcsr is the e2k %pfpfr (the layout of
+// the x86 MXCSR), not the LoongArch FCSR: only these constants know it.  The
+// flags are sticky, unlike the LoongArch cause bits.
+constexpr uint32_t kFPURoundingModeShift = 13;
+constexpr uint32_t kFPURoundingModeMask = 3u << kFPURoundingModeShift;
+enum FPURoundingMode : uint32_t {
+  RN = 0u << kFPURoundingModeShift, RM = 1u << kFPURoundingModeShift,
+  RP = 2u << kFPURoundingModeShift, RZ = 3u << kFPURoundingModeShift,
+  kRoundToNearest = RN, kRoundToZero = RZ, kRoundToPlusInf = RP, kRoundToMinusInf = RM,
+  mode_round = RN, mode_ceil = RP, mode_floor = RM, mode_trunc = RZ,
+};
+constexpr uint32_t kFCSRInvalidOpCauseBit = 0, kFCSRDivideByZeroCauseBit = 2, kFCSROverflowCauseBit = 3,
+                   kFCSRUnderflowCauseBit = 4, kFCSRInexactCauseBit = 5;
+#endif  // LA_ASM_V8
+
+// One wide command of the current instruction; L is the last one of a
+// one-slot instruction, L2 of a two-slot one.
+#define C(...) do { cmd(); __VA_ARGS__; end(); } while (0)
+#define L(...) do { cmd(); __VA_ARGS__; last(1); } while (0)
+#define L2(...) do { cmd(); __VA_ARGS__; last(2); } while (0)
+#define LF(...) do { cmd(); __VA_ARGS__; finish(); } while (0)
+class Assembler : private e2k::Assembler {
+  typedef e2k::Assembler E;
+  typedef e2k::Reg Reg;
+  typedef e2k::Pred Pred;
+  typedef e2k::Sreg Sreg;
+  typedef e2k::Src1 Src1;
+  typedef void (E::*Alu)(int, e2k::Src1, e2k::Src2, Reg);            // also loads, stores, mask compares
+  typedef void (E::*Cmp)(int, e2k::Src1, e2k::Src2, Pred);
+  typedef void (E::*Mrg)(int, e2k::Src1, e2k::Src2, Reg, Pred);
+  typedef void (E::*Un)(int, e2k::Src2, Reg);
+
+ public:
+  explicit Assembler(uint64_t base = 0) : E(base) {}
+  using E::code;
+  using E::pc_offset;
+  using E::data;
+  using E::clear;
+  // One byte of an instruction assembled elsewhere.
+  void raw_byte(uint8_t b) { assert(!in_slot_); append(b); }
+  // Entry and exit code is not LoongArch: it is written with the e2k encoder.
+  E& raw() { assert(!in_slot_); return *this; }
+
+  // The branch offset (in instructions) held by the b/bl/beq.../bceqz/bcnez
+  // instruction at `slot`, for linking and binding labels.
+  static int32_t branch_offset_at(const uint8_t* slot) {
+    int at; uint32_t cs0 = get32(slot + cs0_at(slot, &at));
+    int64_t bytes = at + int64_t(int32_t(cs0 << 4) >> 4) * 8;
+    assert(bytes % kSlot == 0);
+    return int32_t(bytes / kSlot);
+  }
+  static void set_branch_offset_at(uint8_t* slot, int32_t offset) {
+    int at, w = cs0_at(slot, &at);
+    int64_t d = (int64_t(offset) * kSlot - at) / 8;
+    assert(d >= -(1 << 27) && d < (1 << 27));
+    put32(slot + w, (get32(slot + w) & 0xf0000000u) | (uint32_t(d) & 0x0fffffffu));
+  }
+
+  // The same in bytes from the start of the slot (a multiple of 8): code
+  // that is moved keeps its targets outside by these.
+  static bool is_branch(const uint8_t* slot) { int at; return cs0_at(slot, &at, false) != 0; }
+  static int64_t branch_target_at(const uint8_t* slot) {
+    int at; uint32_t cs0 = get32(slot + cs0_at(slot, &at));
+    return at + int64_t(int32_t(cs0 << 4) >> 4) * 8;
+  }
+  static void set_branch_target_at(uint8_t* slot, int64_t bytes) {
+    int at, w = cs0_at(slot, &at);
+    int64_t d = (bytes - at) / 8;
+    assert((bytes - at) % 8 == 0 && d >= -(1 << 27) && d < (1 << 27));
+    put32(slot + w, (get32(slot + w) & 0xf0000000u) | (uint32_t(d) & 0x0fffffffu));
+  }
+  // pcaddi keeps its operand in a 32-bit literal, the last word of the slot.
+  static bool is_pcaddi(const uint8_t* slot) {
+    // `rrd %ip` into the scratch register: the first two words
+    static const uint64_t model = [] { Assembler a; a.pcaddi(a0, 0); uint64_t w; memcpy(&w, a.data(), 8); return w; }();
+    return !memcmp(slot, &model, 8);
+  }
+  static int32_t pcaddi_offset_at(const uint8_t* slot) { return int32_t(get32(slot + kSlot - 4)) / kSlot; }
+  static void set_pcaddi_offset_at(uint8_t* slot, int32_t offset) { put32(slot + kSlot - 4, uint32_t(offset * kSlot)); }
+  // li64 keeps its value in a 64-bit literal, the last two words of the slot.
+  static uint64_t li64_at(const uint8_t* slot) { return uint64_t(get32(slot + kSlot - 8)) << 32 | get32(slot + kSlot - 4); }
+  static void set_li64_at(uint8_t* slot, uint64_t v) { put32(slot + kSlot - 8, uint32_t(v >> 32)); put32(slot + kSlot - 4, uint32_t(v)); }
+
+  // ---- not LoongArch: entry from C, return to C, call of a C function -------
+  // Entry of a function called by C with nargs <= 8 arguments: opens the one
+  // window all the code runs in, moves the arguments to a0.., sets sp to the
+  // top of the C stack and clears every other register (%r0 must hold 0).
+  // Registers the caller did not set are not read: what is left in them may
+  // be a diagnostic value (of a failed speculative operation), and any
+  // non-speculative use of one, a move or a store included, is SIGILL.
+  void enter(int nargs) {
+    assert(nargs >= 0 && nargs <= 8);
+    C(setwd(kWindow); setbn(5, 32, 0));
+    C(for (int i = 4; i < 8; i++) addd(i - 4, i < nargs ? Src1(e2k::r(i)) : Src1(0), 0, e2k::r(4 + i)));
+    C(for (int i = 0; i < 4; i++) addd(i, i < nargs ? Src1(e2k::r(i)) : Src1(0), 0, e2k::r(4 + i)));
+    Reg rest[59]; int n = 0;
+    for (int i = 0; i < 64; i++) if (i < 3 || i >= 12) rest[n++] = e2k::r(i);
+    for (int i = 0; i < 4; i++) rest[n++] = e2k::b(i);
+    for (int i = 0; i < n; i += 6) C(for (int j = 0; j < 6 && i + j < n; j++) addd(j, 0, 0, rest[i + j]));
+    LF(getsp(0, 0, R(sp)));
+  }
+  // Return to the C caller of enter() with the value of a0.
+  void leave() { C(addd(0, R(a0), 0, e2k::r(0)); return_(e2k::ctpr3)); LF(ct(e2k::ctpr3)); }
+  // Call of the C function at `target` with ngp integer arguments in a0.. and
+  // then nfp floating point ones in f0..; the result comes back in a0 and f0
+  // (results >= 1) and a1 (results == 2).  The results are moved
+  // speculatively: a function that returns nothing leaves anything in its
+  // %r0, a diagnostic value too.  Such a value then sits in a0 and f0 until
+  // they are written; using it traps.  C parameters are the first eight registers of the callee whatever
+  // their type.  The callee's window starts at %b[4]: `call` raises SIGILL
+  // unless the caller's window ends at most 8 registers above that start, so
+  // the argument area is the top of the window (measured: wsz - wbs <= 4).  The hardware
+  // stack pointer is first lowered to 64 bytes below sp (the callee owns that
+  // area), so C frames go under the frames of this code; the hardware return
+  // restores it.  Every register of the layer survives the call.
+  // ponytail: integer arguments first, then floating point ones; a C function
+  // that mixes them in another order needs the real signature here.
+  void ccall(Register target, int ngp, int nfp, int results) {
+    assert(ngp >= 0 && nfp >= 0 && ngp + nfp <= 8 && results >= 0 && results <= 2);
+    C(rrd(0, Sreg::usd_lo, T0));
+    C(andd(0, T0, 0xffffffffffffll, T0));        // usd.base
+    C(subd(0, R(sp), T0, T0));
+    C(subd(0, T0, 64, T0));
+    C(andd(0, T0, -16, T0));
+    C(sard(0, T0, 63, T1));
+    C(andd(0, T0, T1, T0));                      // min(sp - 64 - base, 0)
+    C(getsp(0, T0, T1));
+    auto arg = [&](int i) { return i >= ngp && i < ngp + nfp ? e2k::r(32 + i - ngp) : e2k::r(4 + i); };
+    C(for (int i = 0; i < 6; i++) addd(i, arg(i), 0, e2k::b(4 + i)));
+    C(movtd(R(target), e2k::ctpr1); addd(1, arg(6), 0, e2k::b(10)); addd(2, arg(7), 0, e2k::b(11)));
+    C(call(e2k::ctpr1, kWindow - 4));
+    cmd();
+    if (results >= 1) { addd(0, e2k::b(4), 0, R(a0)); sm(0); addd(2, e2k::b(4), 0, e2k::r(32)); sm(2); }
+    if (results == 2) { addd(1, e2k::b(5), 0, R(a1)); sm(1); }
+    finish();
+  }
+  // rd = a 64-bit value that can be read back and replaced (li64_at).
+  void li64(Register rd, int64_t value) { L(addd(0, 0, e2k::Src2::lit64(value), D(rd))); }
+
+  // ---- branches ------------------------------------------------------------
+  // The target is prepared in %ctpr1 by the first command and taken by the
+  // second: measured faster than a single `ibranch` (see NOTES.md).
+  void b(int32_t offset) { C(disp(e2k::ctpr1, to(offset))); L(ct(e2k::ctpr1)); }
+  void bl(int32_t offset) { C(disp(e2k::ctpr1, to(offset))); L(rrd(0, Sreg::nip, D(ra)); ct(e2k::ctpr1)); }
+  void beq(Register rj, Register rd, int32_t offset) { br(&E::cmpedb, false, R(rj), R(rd), offset); }
+  void bne(Register rj, Register rd, int32_t offset) { br(&E::cmpedb, true, R(rj), R(rd), offset); }
+  void blt(Register rj, Register rd, int32_t offset) { br(&E::cmpldb, false, R(rj), R(rd), offset); }
+  void bge(Register rj, Register rd, int32_t offset) { br(&E::cmpldb, true, R(rj), R(rd), offset); }
+  void bltu(Register rj, Register rd, int32_t offset) { br(&E::cmpbdb, false, R(rj), R(rd), offset); }
+  void bgeu(Register rj, Register rd, int32_t offset) { br(&E::cmpbdb, true, R(rj), R(rd), offset); }
+  void beqz(Register rj, int32_t offset) { br(&E::cmpedb, false, R(rj), 0, offset); }
+  void bnez(Register rj, int32_t offset) { br(&E::cmpedb, true, R(rj), 0, offset); }
+  void bceqz(CFRegister cj, int32_t offset) { L(ibranch(to(offset), ~P(cj))); }
+  void bcnez(CFRegister cj, int32_t offset) { L(ibranch(to(offset), P(cj))); }
+  // pc = rj + offset instructions, rd = address of the next instruction.
+  // Two slots when offset != 0.
+  void jirl(Register rd, Register rj, int32_t offset) {
+    e2k::Ctpr c = rd == zero_reg && rj == ra ? e2k::ctpr2 : e2k::ctpr1;
+    if (offset == 0) C(movtd(R(rj), c));
+    else { C(addd(0, R(rj), int64_t(offset) * kSlot, T0)); C(movtd(T0, c)); }
+    cmd();
+    if (rd != zero_reg) rrd(0, Sreg::nip, D(rd));
+    ct(c);
+    last(offset ? 2 : 1);
+  }
+
+  // ---- integer arithmetic --------------------------------------------------
