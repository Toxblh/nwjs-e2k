diff --git a/chromium/v8/src/codegen/e2k/e2k_asm.h b/chromium/v8/src/codegen/e2k/e2k_asm.h
new file mode 100644
index 0000000000..52bc5dc565
--- /dev/null
+++ b/chromium/v8/src/codegen/e2k/e2k_asm.h
@@ -0,0 +1,427 @@
+// e2k wide-command encoder (prototype for the V8 backend).
+// Direct emission: one command is built between begin() and end(), every
+// arithmetic-logic operation names its channel explicitly.  Layout, field
+// positions and literal placement follow GNU as output; test_encode compares
+// byte for byte.  Operation codes and channel masks come from opcodes.inc,
+// which gen_opcodes.py reads back from the assembler.  See NOTES.md.
+#ifndef E2K_ASM_H_
+#define E2K_ASM_H_
+
+#include <cassert>
+#include <cstdint>
+#include <cstring>
+#include <type_traits>
+#include <vector>
+
+namespace e2k {
+
+// Operand encodings shared by src1/src2/src3/dst fields.
+struct Reg { uint8_t code; };
+constexpr Reg r(int n) { return {uint8_t(0x80 | n)}; }   // %rN, window-relative, N < 64
+constexpr Reg b(int n) { return {uint8_t(n)}; }          // %b[N], rotatable, N < 128
+constexpr Reg g(int n) { return {uint8_t(0xe0 | n)}; }   // %gN, global, N < 32
+constexpr Reg empty{0xdf};                               // %empty: result is dropped
+enum Ctpr { ctpr1 = 1, ctpr2 = 2, ctpr3 = 3 };
+struct Pred { uint8_t n; bool negated = false; Pred operator~() const { return {n, !negated}; } };
+constexpr Pred pred(int n) { return {uint8_t(n)}; }      // %predN, N < 32
+// Local predicates of one command: @p0..@p3 are loaded by pass(), @p4..@p6
+// are produced by andp/landp/movep.
+struct Lp { uint8_t n; bool negated = false; Lp operator~() const { return {n, !negated}; } };
+constexpr Lp lp(int n) { return {uint8_t(n)}; }
+// State registers for rrs/rrd/rws/rwd.
+enum class Sreg : uint8_t {
+#define E2K_OP(...)
+#define E2K_SREG(name, code) name = code,
+#include "opcodes.inc"
+#undef E2K_OP
+#undef E2K_SREG
+};
+
+struct Label {
+  int64_t pos = -1;                       // offset in the buffer once bound
+  struct Use { size_t word; size_t bundle; bool abs64; };
+  std::vector<Use> uses;
+};
+
+// First operand: a register or a literal 0..31.
+struct Src1 {
+  uint8_t code;
+  Src1(Reg reg) : code(reg.code) {}
+  Src1(int v) : code(uint8_t(0xc0 | v)) { assert(v >= 0 && v < 32); }
+};
+// Second operand: a register, a number (as picks the literal size, so do we)
+// or the absolute address of a label (64-bit literal).
+struct Src2 {
+  enum Kind { kReg, kImm, kLabel } kind;
+  uint8_t code = 0; int64_t imm = 0; Label* label = nullptr;
+  int8_t cls = -1;                         // forced literal size: 1 = 32 bits, 2 = 64 bits
+  Src2(Reg reg) : kind(kReg), code(reg.code) {}
+  template <class T, class = std::enable_if_t<std::is_integral<T>::value>>
+  Src2(T v) : kind(kImm), imm(int64_t(v)) {}
+  Src2(Label* l) : kind(kLabel), label(l) {}
+  // A literal of a fixed size whatever the value, for code that is patched later.
+  static Src2 lit32(int64_t v) { Src2 s(v); s.cls = 1; return s; }
+  static Src2 lit64(int64_t v) { Src2 s(v); s.cls = 2; return s; }
+};
+
+class Assembler {
+ public:
+  // `base` is the address the first byte will have at run time.
+  explicit Assembler(uint64_t base = 0) : base_(base) { reset(); }
+
+  const std::vector<uint8_t>& code() const { assert(!open_); return buf_; }
+  uint8_t* data() { assert(!open_); return buf_.data(); }   // for patching literal and displacement syllables
+  size_t pc_offset() const { return buf_.size(); }
+  void clear() { assert(!open_); buf_.clear(); }
+  void append(uint8_t b) { assert(!open_); buf_.push_back(b); }
+  // Size in bytes the command built so far would have.
+  int size() const { Plan p; bool ok = plan(p); assert(ok); (void)ok; return ((p.total + 1) & ~1) * 4; }
+  void set_base(uint64_t base) { assert(buf_.empty()); base_ = base; }
+
+  void bind(Label* l) {
+    assert(!open_ && l->pos < 0);
+    l->pos = int64_t(buf_.size());
+    for (const Label::Use& u : l->uses) patch(u, l->pos);
+  }
+
+  // ---- wide command ------------------------------------------------------
+  void begin() { assert(!open_); reset(); open_ = true; }
+  void nop(int n) { assert(open_ && n >= 0 && n <= 7); nop_ = n; }
+  // `min_words` stretches the command with zero words (placed where as puts
+  // its alignment word) so that it is at least that long; they cost no time.
+  void end(int min_words = 0);
+  // False when the operations given so far cannot make one command: literals
+  // do not pack into four LTS, too many conditions, or more than 64 bytes.
+  bool fits() const { Plan p; return plan(p); }
+
+  // ---- arithmetic-logic operations, generated from opcodes.inc -----------
+  //   ALOPF1/11   name(ch, src1, src2, dst)
+  //   ALOPF2/12   name(ch, src2, dst)
+  //   ALOPF3      name(ch, base, index_or_disp, value)    stores
+  //   ALOPF7      name(ch, src1, src2, pred)              compares
+  //   ALOPF21     name(ch, src1, src2, src3, dst)
+  //   MERGE       name(ch, src1, src2, dst, pred)         dst = pred ? src2 : src1
+  //   ALOPF15     name(ch, src2, state_register)          rws/rwd
+  //   ALOPF16     name(ch, state_register, dst)           rrs/rrd
+  struct Op { uint8_t cop, opce, opc2, opce2; bool w32; uint8_t plain, ales; };
+#define E2K_SREG(...)
+#define E2K_OP(name, fmt, cop, opce, opc2, opce2, w32, plain, ales) \
+  E2K_##fmt(name, (Op{cop, opce, opc2, opce2, bool(w32), plain, ales}))
+#define E2K_ALOPF1(name, op) \
+  void name(int ch, Src1 s1, Src2 s2, Reg d) { alop(op, ch, s1.code, s2, d.code); }
+#define E2K_ALOPF11 E2K_ALOPF1
+#define E2K_ALOPF3 E2K_ALOPF1
+#define E2K_ALOPF2(name, op) \
+  void name(int ch, Src2 s2, Reg d) { Op o = op; alop(o, ch, o.opce, s2, d.code); }
+#define E2K_ALOPF12 E2K_ALOPF2
+#define E2K_ALOPF7(name, op) \
+  void name(int ch, Src1 s1, Src2 s2, Pred p) { Op o = op; assert(!p.negated); alop(o, ch, s1.code, s2, uint8_t(o.opce << 5 | p.n)); }
+#define E2K_ALOPF21(name, op) \
+  void name(int ch, Src1 s1, Src2 s2, Reg s3, Reg d) { alop(op, ch, s1.code, s2, d.code, s3.code); }
+#define E2K_MERGE(name, op) \
+  void name(int ch, Src1 s1, Src2 s2, Reg d, Pred p) { alop(op, ch, s1.code, s2, d.code); mrgc_[ch] = p; mrgc_mask_ |= 1 << ch; }
+#define E2K_ALOPF15(name, op) \
+  void name(int ch, Src2 s2, Sreg d) { Op o = op; alop(o, ch, o.opce, s2, uint8_t(d)); }
+#define E2K_ALOPF16(name, op) \
+  void name(int ch, Sreg s, Reg d) { alop(op, ch, uint8_t(s), 0, d.code); }
+#include "opcodes.inc"
+#undef E2K_ALOPF1
+#undef E2K_ALOPF11
+#undef E2K_ALOPF3
+#undef E2K_ALOPF2
+#undef E2K_ALOPF12
+#undef E2K_ALOPF7
+#undef E2K_ALOPF21
+#undef E2K_MERGE
+#undef E2K_ALOPF15
+#undef E2K_ALOPF16
+#undef E2K_OP
+#undef E2K_SREG
+
+  // dst = address of label
+  void lea(int ch, Label* l, Reg d) { addd(ch, 0, l, d); }
+  // Modifiers of the operation already placed in channel `ch`.
+  void sm(int ch) { assert(als_mask_ >> ch & 1); als_[ch] |= 0x80000000u; }             // `op,ch,sm`
+  void when(int ch, Pred p) { assert(als_mask_ >> ch & 1); rlp_[ch] = p; rlp_mask_ |= 1 << ch; }  // `op ? %pred`
+
+  // ---- predicate logic (PLS) ---------------------------------------------
+  void pass(Pred src, Lp dst) {            // pass %predN, @p0..@p3
+    assert(open_ && !src.negated && !dst.negated && dst.n < 4);
+    elp_[dst.n] = uint8_t(0x60 | src.n); pls_used_ |= 1 << dst.n / 2;
+  }
+  void pass(Lp src, Pred dst) {            // pass @p4..@p6, %predN
+    assert(open_ && !src.negated && !dst.negated && src.n >= 4 && src.n <= 6);
+    clp_[src.n - 4] |= uint16_t(0x20 | dst.n); pls_used_ |= 1 << (src.n - 4);
+  }
+  void andp(Lp a, Lp b, Lp dst) { clp(0, a, b, dst); }
+  void landp(Lp a, Lp b, Lp dst) { clp(1, a, b, dst); }
+  void movep(Lp a, Lp b, Lp dst) { clp(3, a, b, dst); }
+
+  // ---- control transfer --------------------------------------------------
+  void disp(Ctpr c, Label* l) { cs0(uint32_t(c) << 30, l); }
+  void ldisp(Ctpr c, Label* l) { assert(c == ctpr2); cs0(uint32_t(c) << 30 | 1u << 28, l); }
+  void sdisp(Ctpr c, int n) { assert(n >= 0 && n < 32); cs0(uint32_t(c) << 30 | 2u << 28 | uint32_t(n), nullptr); }
+  void return_(Ctpr c) { assert(c == ctpr3); cs0(0xf0000000u, nullptr); }
+  void movtd(Src2 src, Ctpr c) { alop(Op{0x61, 0xc0, 0, 0, false, 0x01, 0}, 0, 0xc0, src, uint8_t(0xd0 | c)); }
+  void ct(Ctpr c) { ss(0xc0000000u | uint32_t(c) << 10 | 0x20); }
+  void ct(Ctpr c, Pred p) { ss(0xc0000000u | uint32_t(c) << 10 | cond(p)); }
+  void call(Ctpr c, int wbs) { ct(c); cs1(0x50000000u | uint32_t(wbs)); }
+  void call(Ctpr c, int wbs, Pred p) { ct(c, p); cs1(0x50000000u | uint32_t(wbs)); }
+  void ibranch(Label* l) { ss(0xc0000020u); cs0(0, l); }
+  void ibranch(Label* l, Pred p) { ss(0xc0000000u | cond(p)); cs0(0, l); }
+  // `ibranch l ? %MLOCK` (as also spells it `rbranch l`): taken when the store
+  // with mas = 2 of this command lost the lock taken by a load with mas = 7.
+  void ibranch_mlock(Label* l) { ss(0xc0000100u); cs0(0, l); }
+  // `mas = v` of the load or store in channel 0, 2, 3 or 5.
+  void mas(int ch, int v) {
+    static const int8_t shift[6] = {21, -1, 14, 7, -1, 0};
+    assert(open_ && shift[ch] >= 0 && v > 0 && v < 128 && (!has_cs1_ || mas_));
+    if (!mas_) cs1_ = 0x60000000u;
+    mas_ = has_cs1_ = true; cs1_ |= uint32_t(v) << shift[ch];
+  }
+  // `wait ld_c = .., st_c = ..`: memory barrier.
+  void wait(bool ld_c, bool st_c) { cs1(0x30000000u | uint32_t(ld_c) << 3 | uint32_t(st_c) << 2); }
+
+  // ---- procedure window --------------------------------------------------
+  void setwd(int wsz, bool nfx = true, bool dbl = false) {
+    assert(!setwd_ && wsz >= 0 && wsz <= 0x70);
+    setwd_ = true; lit(-1, int64_t(wsz) << 5 | int64_t(nfx) << 4 | int64_t(dbl) << 3, nullptr, 1); setbr(0);
+  }
+  void setbn(int rsz, int rbs, int rcur) {
+    assert(rsz >= 0 && rsz < 64 && rbs >= 0 && rbs < 64 && rcur >= 0 && rcur < 64);
+    setbr(1u << 26 | uint32_t(rcur) << 12 | uint32_t(rsz) << 6 | uint32_t(rbs));
+  }
+  void setbp(int psz) { assert(psz >= 0 && psz < 32); setbr(1u << 27 | uint32_t(psz) << 18); }
+
+ private:
+  struct Lit { int64_t v; Label* label; uint8_t cls; int8_t ch; };   // cls: 0/1/2 = 16/32/64 bits; ch < 0: setwd
+  struct Half { int8_t owner; uint8_t sub; };                        // literal and which 16-bit piece of it
+  struct Plan {
+    Half half_lts[8]; uint8_t choice[7]; unsigned best;
+    uint32_t lts[4]; uint8_t ref[7]; int nlts, ncds, npls, nhalf, mid, total; bool ales25; uint16_t cds[6], half[4];
+  };
+  bool plan(Plan& p) const;
+
+  void reset() {
+    als_mask_ = ales_mask_ = rlp_mask_ = mrgc_mask_ = pls_used_ = 0;
+    has_ss_ = has_cs0_ = has_cs1_ = setwd_ = setbr_ = mas_ = false;
+    nop_ = norder_ = nlits_ = 0; cs0_label_ = nullptr;
+    memset(elp_, 0, sizeof elp_); memset(clp_, 0, sizeof clp_);
+  }
+  void word(uint32_t w) { for (int i = 0; i < 4; i++) buf_.push_back(uint8_t(w >> (8 * i))); }
+  void als(int ch, uint32_t w) {
+    assert(open_ && ch >= 0 && ch < 6 && !(als_mask_ & (1 << ch)));
+    als_mask_ |= 1 << ch; als_[ch] = w; order_[norder_++] = ch;
+  }
+  // ALS = cop:b2:src2:b0, plus ALES = opc2:ales_lo where the channel needs it.
+  void alop(Op op, int ch, uint8_t b2, Src2 s2, uint8_t b0, int ales_lo = -1) {
+    assert((op.plain | op.ales) >> ch & 1 && "operation is not available in this channel");
+    uint8_t b1 = s2.code;
+    if (s2.kind == Src2::kLabel) { b1 = 0; lit(ch, 0, s2.label, 2); }
+    else if (s2.kind == Src2::kImm) {
+      int64_t v = s2.imm;
+      if (s2.cls >= 0) { b1 = 0; lit(ch, v, nullptr, s2.cls); }
+      else if (v >= 0 && v <= 15) b1 = uint8_t(0xc0 | v);
+      else {
+        b1 = 0;
+        // as sizes the literal by its value as written: 0xffffffff given to a
+        // 32-bit operation is a 32-bit literal, not the 16-bit -1.
+        assert(!op.w32 || (v >= INT32_MIN && v <= int64_t(UINT32_MAX)));
+        lit(ch, v, nullptr, v >= -32768 && v <= 32767 ? 0 : op.w32 || (v >= INT32_MIN && v <= INT32_MAX) ? 1 : 2);
+      }
+    }
+    als(ch, uint32_t(op.cop) << 24 | uint32_t(b2) << 16 | uint32_t(b1) << 8 | b0);
+    if (op.ales >> ch & 1) { ales_mask_ |= 1 << ch; ales_[ch] = uint16_t(op.opc2 << 8 | (ales_lo < 0 ? op.opce2 : ales_lo)); }
+  }
+  void ss(uint32_t w) { assert(open_ && !has_ss_); has_ss_ = true; ss_ = w; }
+  void cs0(uint32_t w, Label* l) { assert(open_ && !has_cs0_); has_cs0_ = true; cs0_ = w; cs0_label_ = l; }
+  void cs1(uint32_t w) { assert(open_ && !has_cs1_); has_cs1_ = true; cs1_ = w; }
+  // setwd, setbn and setbp share one CS1; without setwd its opcode is 4.
+  void setbr(uint32_t w) { assert(open_ && (!has_cs1_ || setbr_)); if (!setbr_) cs1_ = 0; setbr_ = has_cs1_ = true; cs1_ |= w; }
+  uint32_t cs1_word() const { return setbr_ && !setwd_ ? cs1_ | 0x40000000u : cs1_; }
+  static uint32_t cond(Pred p) { return (p.negated ? 0x60u : 0x40u) | p.n; }
+  void clp(int opc, Lp a, Lp b, Lp dst) {
+    assert(open_ && !dst.negated && dst.n >= 4 && dst.n <= 6 && a.n < dst.n && b.n < dst.n);
+    clp_[dst.n - 4] |= uint16_t(opc << 14 | a.negated << 13 | a.n << 10 | b.negated << 9 | b.n << 6);
+    pls_used_ |= 1 << (dst.n - 4);
+  }
+
+  // Literals are placed the way GNU as does it (place_literals in tc-e2k.c).
+  // The four LTS make eight 16-bit halves; half 2n is the low part of LTSn.
+  // A 16-bit literal may take any half of LTS0/LTS1 (high half tried first)
+  // or be widened to 32 or 64 bits; a 32-bit one takes a whole LTS or is
+  // widened to 64; a 64-bit one starts at LTS0, LTS1 or LTS2.  A half may be
+  // shared by literals whose 16-bit pieces there are equal.  All combinations
+  // are tried, literals with fewer choices first (setwd, 64, 32, 16 bits; in
+  // the order given within a size), and the first one with the smallest mask
+  // of used halves wins (the high half of an LTS being the lower bit).
+  void lit(int ch, int64_t v, Label* l, int cls) { assert(nlits_ < 7); lits_[nlits_++] = Lit{v, l, uint8_t(cls), int8_t(ch)}; }
+  static int choices(const Lit& l, uint8_t pos[11], uint8_t size[11]) {
+    if (l.ch < 0) { pos[0] = 0; size[0] = 2; return 1; }       // setwd owns LTS0
+    static const uint8_t p16[4] = {1, 0, 3, 2};
+    int n = 0;
+    if (l.cls == 0) for (int k = 0; k < 4; k++) { pos[n] = p16[k]; size[n++] = 1; }
+    if (l.cls <= 1) for (int p = 0; p < 8; p += 2) { pos[n] = uint8_t(p); size[n++] = 2; }
+    for (int p = 0; p < 6; p += 2) { pos[n] = uint8_t(p); size[n++] = 4; }
+    return n;
+  }
+  bool same_piece(const Half& h, const Lit& l, int i) const {
+    const Lit& o = lits_[h.owner];
+    if (o.label || l.label) return o.label == l.label && h.sub == i;
+    return uint16_t(uint64_t(o.v) >> 16 * h.sub) == uint16_t(uint64_t(l.v) >> 16 * i);
+  }
+  // ponytail: exhaustive search, up to 11^6 leaves for six 16-bit literals
+  // that cannot fit; fine for a prototype, cache or special-case if it shows up.
+  void search(Plan& p, const int* order, int k, const Half* h, unsigned mask, uint8_t* idx) const {
+    if (mask >= p.best) return;
+    if (k == nlits_) { p.best = mask; memcpy(p.half_lts, h, sizeof p.half_lts); memcpy(p.choice, idx, 7); return; }
+    const Lit& l = lits_[order[k]];
+    uint8_t pos[11], size[11];
+    int n = choices(l, pos, size);
+    for (int c = 0; c < n; c++) {
+      Half t[8]; memcpy(t, h, sizeof t);
+      unsigned m = mask; bool ok = true;
+      for (int i = 0; i < size[c] && ok; i++) {
+        Half& x = t[pos[c] + i];
+        if (x.owner >= 0) ok = same_piece(x, l, i);
+        else { x.owner = int8_t(order[k]); x.sub = uint8_t(i); m |= 1u << ((pos[c] + i) ^ 1); }
+      }
+      if (!ok) continue;
+      idx[order[k]] = uint8_t(c);
+      search(p, order, k + 1, t, m, idx);
+    }
+  }
+
+  void use(Label* l, Label::Use u) { if (l->pos >= 0) patch(u, l->pos); else l->uses.push_back(u); }
+  void patch(const Label::Use& u, int64_t target) {
+    if (u.abs64) {  // two literal syllables: the low word is stored after the high one
+      uint64_t a = base_ + uint64_t(target);
+      put(u.word, uint32_t(a)); put(u.word - 4, uint32_t(a >> 32));
+    } else {        // CS0: 28-bit displacement in 8-byte units from the command start
+      int64_t d = (target - int64_t(u.bundle)) / 8;
+      assert(d >= -(1 << 27) && d < (1 << 27));
+      put(u.word, (get(u.word) & 0xf0000000u) | (uint32_t(d) & 0x0fffffffu));
+    }
+  }
+  uint32_t get(size_t at) const { uint32_t w; memcpy(&w, &buf_[at], 4); return w; }
+  void put(size_t at, uint32_t w) { memcpy(&buf_[at], &w, 4); }
+
+  std::vector<uint8_t> buf_;
+  uint64_t base_;
+  bool open_ = false;
+  uint32_t als_[6]; uint16_t ales_[6]; int als_mask_, ales_mask_;
+  int order_[6], norder_;                      // channels in the order the operations were given
+  Pred rlp_[6], mrgc_[6]; int rlp_mask_, mrgc_mask_;
+  uint8_t elp_[4]; uint16_t clp_[3]; int pls_used_;
+  uint32_t ss_, cs0_, cs1_; bool has_ss_, has_cs0_, has_cs1_, setwd_, setbr_, mas_;
+  Lit lits_[7]; int nlits_, nop_;
+  Label* cs0_label_;
+};
+
+inline bool Assembler::plan(Plan& p) const {
+  // Literal syllables.
+  int order[7], n = 0;
+  for (int i = 0; i < nlits_; i++) if (lits_[i].ch < 0) order[n++] = i;
+  for (int cls = 2; cls >= 0; cls--)
+    for (int i = 0; i < nlits_; i++) if (lits_[i].ch >= 0 && lits_[i].cls == cls) order[n++] = i;
+  Half free_lts[8]; uint8_t idx[7] = {};
+  for (Half& h : free_lts) h = Half{-1, 0};
+  p.best = 0x100;
+  memcpy(p.half_lts, free_lts, sizeof free_lts);
+  search(p, order, 0, free_lts, 0, idx);
+  if (nlits_ && p.best == 0x100) return false;
+  p.nlts = 0;
+  for (int s = 0; s < 4; s++) {
+    p.lts[s] = 0;
+    for (int k = 0; k < 2; k++) {
+      const Half& h = p.half_lts[2 * s + k];
+      if (h.owner < 0) continue;
+      p.nlts = s + 1;
+      if (!lits_[h.owner].label) p.lts[s] |= uint32_t(uint16_t(uint64_t(lits_[h.owner].v) >> 16 * h.sub)) << 16 * k;
+    }
+  }
+  for (int i = 0; i < nlits_; i++) {
+    uint8_t pos[11], size[11];
+    choices(lits_[i], pos, size);
+    int c = p.choice[i];
+    p.ref[i] = uint8_t(size[c] == 1 ? 0xd0 | (pos[c] & 1) << 2 | pos[c] >> 1 : (size[c] == 2 ? 0xd8 : 0xdc) | pos[c] >> 1);
+  }
+
+  // Conditional syllables: per operation in source order, RLP then MRGC.
+  // Operations of one cluster (channels 0-2 or 3-5) under the same predicate
+  // number share a half-syllable.
+  p.ncds = 0;
+  auto add_cds = [&](unsigned mrgc, int ch, Pred pr) {
+    uint16_t key = uint16_t(mrgc << 15 | unsigned(ch >= 3) << 14 | 0x60u | pr.n);
+    int i = 0;
+    while (i < p.ncds && (p.cds[i] & 0xc07f) != key) i++;
+    if (i == 6) return false;
+    if (i == p.ncds) p.cds[p.ncds++] = key;
+    p.cds[i] |= uint16_t(1u << (10 + ch % 3) | unsigned(pr.negated) << (7 + ch % 3));
+    return true;
+  };
+  for (int k = 0; k < norder_; k++) {
+    int ch = order_[k];
+    if (rlp_mask_ >> ch & 1 && !add_cds(0, ch, rlp_[ch])) return false;
+    if (mrgc_mask_ >> ch & 1 && !add_cds(1, ch, mrgc_[ch])) return false;
+  }
+  int ncdsw = (p.ncds + 1) / 2;
+  p.npls = pls_used_ & 4 ? 3 : pls_used_ & 2 ? 2 : pls_used_ & 1;
+
+  // ALES2/ALES5 live in one word before CS1; it is omitted when neither
+  // differs from 0x01c0 (the header bits alone then imply that value).
+  p.ales25 = false;
+  for (int ch = 2; ch < 6; ch += 3) if (ales_mask_ >> ch & 1 && ales_[ch] != 0x01c0) p.ales25 = true;
+  p.nhalf = 0;
+  for (int ch = 0; ch < 5; ch++) if (ch != 2 && ales_mask_ >> ch & 1) p.half[p.nhalf++] = ales_[ch];
+
+  p.mid = 1 + has_ss_ + __builtin_popcount(als_mask_) + has_cs0_ + p.ales25 + has_cs1_;
+  p.total = p.mid + (p.nhalf + 1) / 2 + p.nlts + p.npls + ncdsw;
+  return p.total <= 16;
+}
+
+inline void Assembler::end(int min_words) {
+  assert(open_);
+  // as refuses these two pairs
+  auto cop = [&](int ch) { return als_mask_ >> ch & 1 ? als_[ch] >> 24 & 0x7f : 0u; };
+  auto is_load = [&](int ch) { return cop(ch) >= 0x64 && cop(ch) <= 0x67; };
+  auto is_store = [&](int ch) { return cop(ch) >= 0x24 && cop(ch) <= 0x27; };
+  assert(!(is_store(5) && is_load(0)) && !(is_store(2) && is_load(3)));
+  (void)is_load; (void)is_store;
+
+  Plan p;
+  bool ok = plan(p);
+  assert(ok && "literals or syllables cannot be packed into a wide command"); (void)ok;
+  for (int i = 0; i < nlits_; i++)
+    if (lits_[i].ch >= 0) als_[lits_[i].ch] |= uint32_t(p.ref[i]) << 8;
+
+  size_t start = buf_.size();
+  int ncdsw = (p.ncds + 1) / 2, padded = (p.total + 1) & ~1;
+  assert(min_words % 2 == 0 && min_words <= 16);
+  if (padded < min_words) padded = min_words;
+  word(uint32_t(p.mid - 1) | uint32_t(padded / 2 - 1) << 4 | uint32_t(nop_) << 7 |
+       uint32_t(has_ss_) << 12 | uint32_t(has_cs0_) << 14 | uint32_t(has_cs1_) << 15 |
+       uint32_t(ncdsw) << 16 | uint32_t(p.npls) << 18 | uint32_t(ales_mask_) << 20 | uint32_t(als_mask_) << 26);
+  if (has_ss_) word(ss_);
+  for (int i = 0; i < 6; i++)
+    if (als_mask_ & (1 << i)) word(als_[i]);
+  size_t cs0_word = buf_.size();
+  if (has_cs0_) word(cs0_);
+  if (p.ales25) word(uint32_t(ales_mask_ & 4 ? ales_[2] : 0x01c0) << 16 | (ales_mask_ & 32 ? ales_[5] : 0x01c0));
+  if (has_cs1_) word(cs1_word());
+  for (int i = 0; i < p.nhalf; i += 2) word(uint32_t(p.half[i]) << 16 | (i + 1 < p.nhalf ? p.half[i + 1] : 0));
+  for (int i = p.total; i < padded; i++) word(0);
+  size_t lts_word[4];
+  for (int i = p.nlts - 1; i >= 0; i--) { lts_word[i] = buf_.size(); word(p.lts[i]); }
+  for (int i = p.npls - 1; i >= 0; i--)
+    word(uint32_t(i < 2 ? elp_[2 * i] : 0) << 24 | uint32_t(i < 2 ? elp_[2 * i + 1] : 0) << 16 | clp_[i]);
+  for (int i = ncdsw - 1; i >= 0; i--) word(uint32_t(p.cds[2 * i]) << 16 | (2 * i + 1 < p.ncds ? p.cds[2 * i + 1] : 0));
+  assert(buf_.size() - start == size_t(padded) * 4);
+  if (cs0_label_) use(cs0_label_, {cs0_word, start, false});
+  for (int i = 0; i < nlits_; i++)
+    if (lits_[i].label) use(lits_[i].label, {lts_word[p.ref[i] & 3], start, true});
+  open_ = false;
+}
+
+}  // namespace e2k
+#endif  // E2K_ASM_H_
