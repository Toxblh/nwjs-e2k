From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Anton Palgunov <toxblh@gmail.com>
Date: Mon, 12 Oct 2026 19:50:32 +0100
Subject: [PATCH 24/99] v8: e2k: add the target to the Maglev front-end
 conditions

The Maglev graph builder is compiled into the compiler for Turbolev even
with Maglev disabled, and its headers reject unknown architectures.
Follow the loong64 choices.
---
 chromium/v8/src/maglev/maglev-ir.h      | 4 ++--
 chromium/v8/src/maglev/maglev-reducer.h | 4 ++--
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/chromium/v8/src/maglev/maglev-ir.h b/chromium/v8/src/maglev/maglev-ir.h
index 8f7be06fdb..656f5e25ec 100644
--- a/chromium/v8/src/maglev/maglev-ir.h
+++ b/chromium/v8/src/maglev/maglev-ir.h
@@ -929,7 +929,7 @@ inline constexpr bool IsDoubleRepresentation(ValueRepresentation repr) {
 }
 
 inline constexpr bool IsZeroExtendedRepresentation(ValueRepresentation repr) {
-#if defined(V8_TARGET_ARCH_RISCV64) || defined(V8_TARGET_ARCH_LOONG64)
+#if defined(V8_TARGET_ARCH_RISCV64) || (defined(V8_TARGET_ARCH_LOONG64) || defined(V8_TARGET_ARCH_E2K))
   // on RISC-V and LoongArch64, 32-bit values are always sign-extended.
   return false;
 #else
@@ -3690,7 +3690,7 @@ DEF_FLOAT64_BINARY_NODE(Subtract)
 DEF_FLOAT64_BINARY_NODE(Multiply)
 DEF_FLOAT64_BINARY_NODE(Divide)
 #if defined(V8_TARGET_ARCH_ARM64) || defined(V8_TARGET_ARCH_ARM) || \
-    defined(V8_TARGET_ARCH_RISCV64) || defined(V8_TARGET_ARCH_LOONG64)
+    defined(V8_TARGET_ARCH_RISCV64) || (defined(V8_TARGET_ARCH_LOONG64) || defined(V8_TARGET_ARCH_E2K))
 // On Arm/Arm64/Riscv64/LoongArch64, floating point modulus is implemented with
 // a call to a C++ function, while on x64, it's implemented natively without
 // call.
diff --git a/chromium/v8/src/maglev/maglev-reducer.h b/chromium/v8/src/maglev/maglev-reducer.h
index e19a2af8ba..33170bf11f 100644
--- a/chromium/v8/src/maglev/maglev-reducer.h
+++ b/chromium/v8/src/maglev/maglev-reducer.h
@@ -63,7 +63,7 @@ inline bool IsSupported(CpuOperation op) {
       return CpuFeatures::IsSupported(ARMv8);
 #elif defined(V8_TARGET_ARCH_ARM64) || defined(V8_TARGET_ARCH_PPC64) ||   \
     defined(V8_TARGET_ARCH_S390X) || defined(V8_TARGET_ARCH_RISCV64) ||   \
-    defined(V8_TARGET_ARCH_RISCV32) || defined(V8_TARGET_ARCH_LOONG64) || \
+    defined(V8_TARGET_ARCH_RISCV32) || (defined(V8_TARGET_ARCH_LOONG64) || defined(V8_TARGET_ARCH_E2K)) || \
     defined(V8_TARGET_ARCH_MIPS64)
       return true;
 #else
@@ -81,7 +81,7 @@ inline bool IsSupported(CpuOperation op) {
 #elif defined(V8_TARGET_ARCH_RISCV64) || defined(V8_TARGET_ARCH_RISCV32)
       return CpuFeatures::IsSupported(ZBB);
 #elif defined(V8_TARGET_ARCH_IA32) || defined(V8_TARGET_ARCH_PPC64) || \
-    defined(V8_TARGET_ARCH_LOONG64) || defined(V8_TARGET_ARCH_MIPS64)
+    (defined(V8_TARGET_ARCH_LOONG64) || defined(V8_TARGET_ARCH_E2K)) || defined(V8_TARGET_ARCH_MIPS64)
       return false;
 #else
 #error "V8 does not support this architecture."
