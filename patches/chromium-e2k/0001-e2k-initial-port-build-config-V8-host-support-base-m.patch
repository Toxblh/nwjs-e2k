diff --git a/chromium/base/logging/rust_logger/custom_panic_hook.rs b/chromium/base/logging/rust_logger/custom_panic_hook.rs
index ecc707420d..bb3fc8d502 100644
--- a/chromium/base/logging/rust_logger/custom_panic_hook.rs
+++ b/chromium/base/logging/rust_logger/custom_panic_hook.rs
@@ -15,9 +15,12 @@ pub(crate) fn init() {
 }
 
 fn panic_hook(info: &PanicHookInfo<'_>) {
+    // `Location::file_as_c_str` is not available in older system toolchains
+    // (e.g. rustc 1.87 on e2k), so build the C string by hand.
+    let file = info.location().and_then(|loc| std::ffi::CString::new(loc.file()).ok());
     print_rust_log::print_rust_log(
         &format_args!("{info}"),
-        info.location().map(|loc| loc.file_as_c_str()).unwrap_or(c"<unknown file>"),
+        file.as_deref().unwrap_or(c"<unknown file>"),
         info.location().map(|loc| loc.line()),
         print_rust_log::LogSeverity::Fatal,
     )
