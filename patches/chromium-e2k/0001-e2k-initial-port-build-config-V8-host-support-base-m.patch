diff --git a/chromium/build/rust/allocator/lib.rs b/chromium/build/rust/allocator/lib.rs
index b673b946c7..530ef6c227 100644
--- a/chromium/build/rust/allocator/lib.rs
+++ b/chromium/build/rust/allocator/lib.rs
@@ -93,16 +93,32 @@ mod both_allocators {
     #[linkage = "weak"]
     fn __rust_no_alloc_shim_is_unstable_v2() {}
 
+    #[cfg(not(cr_rustc_alloc_shim_statics))]
     #[rustc_std_internal_symbol]
     #[linkage = "weak"]
     fn __rust_no_alloc_shim_is_unstable() {}
 
+    // Older rustc (e.g. the 1.87 system toolchain used on e2k) reads these two
+    // symbols as `u8` statics instead of calling functions.
+    #[cfg(cr_rustc_alloc_shim_statics)]
+    #[rustc_std_internal_symbol]
+    #[allow(non_upper_case_globals)]
+    #[linkage = "weak"]
+    static __rust_no_alloc_shim_is_unstable: u8 = 0;
+
+    #[cfg(cr_rustc_alloc_shim_statics)]
+    #[rustc_std_internal_symbol]
+    #[allow(non_upper_case_globals)]
+    #[linkage = "weak"]
+    static __rust_alloc_error_handler_should_panic: u8 = 0;
+
     #[rustc_std_internal_symbol]
     #[linkage = "weak"]
     fn __rust_alloc_error_handler_should_panic_v2() -> u8 {
         0
     }
 
+    #[cfg(not(cr_rustc_alloc_shim_statics))]
