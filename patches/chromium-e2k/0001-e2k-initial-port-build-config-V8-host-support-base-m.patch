+// Loads a word that is conservatively treated as a pointer.
+V8_INLINE const void* LoadMaybePointer(const void* const* slot) {
+#if defined(V8_HOST_ARCH_E2K)
+  // Memory words on e2k carry hardware tags and operating on a word with a
+  // non-numeric tag (e.g. a spilled uninitialized register) traps. Load
+  // speculatively and drop tagged words as they cannot be pointers.
+  uintptr_t value;
+  uint32_t tag;  // gettagd only defines the low 32 bits.
+  __asm__("ldd,sm %[slot], 0, %[value]\n\t"
+          "gettagd %[value], %[tag]\n\t"
+          "puttagd %[value], 0, %[value]"
+          : [value] "=&r"(value), [tag] "=&r"(tag)
+          : [slot] "r"(slot));
+  return tag ? nullptr : reinterpret_cast<const void*>(value);
+#else
+  return *slot;
+#endif  // V8_HOST_ARCH_E2K
+}
+
+#if defined(V8_HOST_ARCH_E2K)
+#if defined(V8_ENABLE_DIRECT_HANDLE)
+// ponytail: only the procedure stack of the scanning thread is visited, which
+// is all cppgc needs. V8's own conservative stack scanning (direct handles,
+// --conservative-stack-scanning) also scans stacks of parked threads; that
+// needs a copy of their procedure stacks taken when the marker is set.
+#error "Direct handles are not supported on e2k"
+#endif
+
+// Local registers of all frames live in register windows that are spilled to
+// the procedure stack rather than to the regular stack. User code cannot read
+// the procedure stack directly, so get a copy of it from the kernel. This
+// covers the whole procedure stack of the calling thread, including frames
+// below the marker, which is merely more conservative.
+V8_NOINLINE void IteratePointersInProcedureStack(StackVisitor* visitor) {
+  unsigned long long size = 0;
+  CHECK_EQ(0, syscall(__NR_access_hw_stacks, E2K_GET_PROCEDURE_STACK_SIZE,
+                      nullptr, nullptr, 0, &size));
+  const size_t words = size / sizeof(void*);
+  // The stack does not grow between the two syscalls: both are issued from
+  // this frame and the buffer is allocated up front.
+  auto buffer = std::make_unique_for_overwrite<const void*[]>(words);
+  unsigned long long offset = 0;
+  CHECK_EQ(0, syscall(__NR_access_hw_stacks, E2K_READ_PROCEDURE_STACK_EX,
+                      &offset, buffer.get(), words * sizeof(void*), nullptr));
+  for (size_t i = 0; i < words; ++i) {
+    const void* address = LoadMaybePointer(&buffer[i]);
+    if (address == nullptr) continue;
+    visitor->VisitPointer(address);
+  }
+}
+#endif  // V8_HOST_ARCH_E2K
