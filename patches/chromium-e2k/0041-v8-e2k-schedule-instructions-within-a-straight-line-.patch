+// For a scheduler: how long the result of an operation takes to reach its
+// user depends on what made it (kMade) and on what uses it (kFor*); see
+// la_asm.h for the figures.  kR32: only the low 32 bits of the operands are
+// read.  Bits 6-7: log2 of the size of a load or a store.
+enum : uint8_t { kInt, kInt32, kLoad, kMul, kFp, kFpToInt, kMade = 7, kForInt = 0, kForFp = 8, kForMul = 16, kFor = 24, kR32 = 32 };
+constexpr bool starts(const char* s, const char* p) { return !*p || (*s == *p && starts(s + 1, p + 1)); }
+constexpr bool within(const char* s, const char* p) { return *s && (starts(s, p) || within(s + 1, p)); }
+constexpr uint8_t kind_of(const char* n, bool w32) {
+  bool load = starts(n, "ld"), store = starts(n, "st"), fp = *n == 'f', to_fp = starts(n, "isto") || starts(n, "idto");
+  bool mul = !fp && (within(n, "mul") || within(n, "div") || within(n, "mod")), to_int = fp && within(n, "toi") && !within(n, "toif");
+  return uint8_t((load ? kLoad : mul ? kMul : to_int ? kFpToInt : fp || to_fp ? kFp : w32 && !starts(n, "sxt") ? kInt32 : kInt) |
+                 (fp ? kForFp : mul || to_fp ? kForMul : kForInt) |
+                 (w32 || starts(n, "sxt") || (store && n[2] != 'd') ? kR32 : 0) |
+                 (load || store ? (n[2] == 'b' ? 0 : n[2] == 'h' ? 1 : n[2] == 'w' ? 2 : 3) << 6 : 0));
+}
