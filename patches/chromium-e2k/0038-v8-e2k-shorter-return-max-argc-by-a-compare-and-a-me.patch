From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Anton Palgunov <toxblh@gmail.com>
Date: Tue, 13 Oct 2026 04:16:16 +0100
Subject: [PATCH 38/99] v8: e2k: shorter return: max(argc) by a compare and a
 merge, no jump to a shared return

The count of arguments to drop, max(argc, parameter count), took six
slots (li, slt, maskeqz, masknez, or); maxi_d is a compare and a merge.
Return sites are no longer canonicalized: the jump to the one return
sequence cost more than the sequence itself. A truncation to 32 bits of
an arithmetic shift by 32 or more that has other users is the shift
itself. fib(30) under TurboFan: 200 -> 171 ms.
---
 chromium/v8/src/codegen/e2k/assembler-e2k.cc  |  3 +++
 chromium/v8/src/codegen/e2k/assembler-e2k.h   |  2 ++
 chromium/v8/src/codegen/e2k/la_asm.h          |  2 ++
 .../backend/e2k/code-generator-e2k.cc         | 19 +++----------
 .../backend/e2k/instruction-selector-e2k.cc   | 27 +++++++++++--------
 5 files changed, 26 insertions(+), 27 deletions(-)

diff --git a/chromium/v8/src/codegen/e2k/assembler-e2k.cc b/chromium/v8/src/codegen/e2k/assembler-e2k.cc
index d1de627151..c7a8ea76b8 100644
--- a/chromium/v8/src/codegen/e2k/assembler-e2k.cc
+++ b/chromium/v8/src/codegen/e2k/assembler-e2k.cc
@@ -1130,6 +1130,9 @@ void Assembler::TailCallC(int arg, int32_t offset) {
 }
 void Assembler::li64(Register rd, int64_t imm) { LA(li64(rd, imm)); }
 void Assembler::li(Register rd, int64_t imm) { LA(li(rd, imm)); }
+void Assembler::maxi_d(Register rd, Register rj, int32_t imm) {
+  LA(maxi_d(rd, rj, imm));
+}
 
 void Assembler::b(int32_t offset) { LA(b(offset)); }
 void Assembler::bl(int32_t offset) { LA(bl(offset)); }
diff --git a/chromium/v8/src/codegen/e2k/assembler-e2k.h b/chromium/v8/src/codegen/e2k/assembler-e2k.h
index 64e80fe5d5..3b21d830e5 100644
--- a/chromium/v8/src/codegen/e2k/assembler-e2k.h
+++ b/chromium/v8/src/codegen/e2k/assembler-e2k.h
@@ -399,6 +399,8 @@ class V8_EXPORT_PRIVATE Assembler : public AssemblerBase {
   void li64(Register rd, int64_t imm);
   // rd = imm, not patchable.
   void li(Register rd, int64_t imm);
+  // rd = max(rj, imm), signed.
+  void maxi_d(Register rd, Register rj, int32_t imm);
 
   // Conditional branches on registers (beq..bnez) emitted in this scope are
   // almost never taken: deoptimization, deferred code. They become one wide
diff --git a/chromium/v8/src/codegen/e2k/la_asm.h b/chromium/v8/src/codegen/e2k/la_asm.h
index 3c29361d64..16c4591fca 100644
--- a/chromium/v8/src/codegen/e2k/la_asm.h
+++ b/chromium/v8/src/codegen/e2k/la_asm.h
@@ -299,6 +299,8 @@ class Assembler : private e2k::Assembler {
   void slt(Register rd, Register rj, Register rk) { set(&E::cmpldb, rd, R(rj), R(rk)); }
   void sltu(Register rd, Register rj, Register rk) { set(&E::cmpbdb, rd, R(rj), R(rk)); }
   void slti(Register rd, Register rj, int32_t si12) { set(&E::cmpldb, rd, R(rj), si12); }
+  // Not LoongArch: rd = max(rj, imm), signed.
+  void maxi_d(Register rd, Register rj, int32_t imm) { C(cmpldb(0, R(rj), imm, PT0)); L(merged(0, R(rj), imm, D(rd), PT0)); }
   void sltui(Register rd, Register rj, int32_t si12) { set(&E::cmpbdb, rd, R(rj), si12); }
   // pc is the address of this slot.  pcaddi counts in instructions, pcaddu18i
   // in units of 2^16 instructions (it pairs with jirl); pcaddu12i and
