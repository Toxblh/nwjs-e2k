index a9716c46f8..820c28ab45 100644
--- a/chromium/v8/src/compiler/backend/e2k/code-generator-e2k.cc
+++ b/chromium/v8/src/compiler/backend/e2k/code-generator-e2k.cc
@@ -5303,17 +5303,8 @@ void CodeGenerator::AssembleReturn(InstructionOperand* additional_pop_count) {
   if (call_descriptor->IsCFunctionCall()) {
     AssembleDeconstructFrame();
   } else if (frame_access_state()->has_frame()) {
-    // Canonicalize JSFunction return sites for now unless they have an variable
-    // number of stack slot pops.
-    if (additional_pop_count->IsImmediate() &&
-        g.ToConstant(additional_pop_count).ToInt32() == 0) {
-      if (return_label_.is_bound()) {
-        __ Branch(&return_label_);
-        return;
-      } else {
-        __ bind(&return_label_);
-      }
-    }
+    // Return sites are not canonicalized: a jump to the one return sequence
+    // costs more cycles than the sequence takes slots.
     if (drop_jsargs) {
       // Get the actual argument count
       __ Ld_d(t0, MemOperand(fp, StandardFrameConstants::kArgCOffset));
@@ -5323,11 +5314,7 @@ void CodeGenerator::AssembleReturn(InstructionOperand* additional_pop_count) {
   if (drop_jsargs) {
     // We must pop all arguments from the stack (including the receiver). This
     // number of arguments is given by max(1 + argc_reg, parameter_count).
-    if (parameter_slots > 1) {
-      __ li(t1, parameter_slots);
-      __ slt(t2, t0, t1);
-      __ Movn(t0, t1, t2);
-    }
+    if (parameter_slots > 1) __ maxi_d(t0, t0, parameter_slots);
     __ Alsl_d(sp, t0, sp, kSystemPointerSizeLog2);
   } else if (additional_pop_count->IsImmediate()) {
     int additional_count = g.ToConstant(additional_pop_count).ToInt32();
diff --git a/chromium/v8/src/compiler/backend/e2k/instruction-selector-e2k.cc b/chromium/v8/src/compiler/backend/e2k/instruction-selector-e2k.cc
index 9832c0adaa..2f522ac8f6 100644
--- a/chromium/v8/src/compiler/backend/e2k/instruction-selector-e2k.cc
+++ b/chromium/v8/src/compiler/backend/e2k/instruction-selector-e2k.cc
@@ -1907,22 +1907,27 @@ void InstructionSelector::VisitTruncateInt64ToInt32(OpIndex node) {
   E2kOperandGenerator g(this);
   // TODO(e2k): Check TruncateInt64ToInt32 in VisitNode
   OpIndex value = this->Get(node).input(0);
-  if (CanCover(node, value)) {
-    if (Get(value).Is<Opmask::kWord64ShiftRightArithmetic>()) {
-      const ShiftOp& shift = Cast<ShiftOp>(value);
-      auto shift_value = shift.right();
-      if (CanCover(value, shift.left()) &&
-          TryEmitExtendingLoad(this, value, node)) {
-        return;
-      } else if (int64_t constant;
-                 MatchSignedIntegralConstant(shift_value, &constant)) {
-        if (constant >= 32 && constant <= 63) {
+  if (Get(value).Is<Opmask::kWord64ShiftRightArithmetic>()) {
+    const ShiftOp& shift = Cast<ShiftOp>(value);
+    auto shift_value = shift.right();
+    bool cover = CanCover(node, value);
+    if (cover && CanCover(value, shift.left()) &&
+        TryEmitExtendingLoad(this, value, node)) {
+      return;
+    } else if (int64_t constant;
+               MatchSignedIntegralConstant(shift_value, &constant)) {
+      if (constant >= 32 && constant <= 63) {
+        if (cover) {
           // After smi untagging no need for truncate. Combine sequence.
           Emit(kE2kSra_d, g.DefineAsRegister(node),
                g.UseRegister(shift.left()),
                g.UseImmediate(static_cast<int32_t>(constant)));
-          return;
+        } else {
+          // The shift has other users; its result is a sign-extended 32-bit
+          // value already.
+          EmitIdentity(node);
         }
+        return;
       }
     }
   }
