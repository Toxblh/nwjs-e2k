+    if (is_int32(rk.immediate()) && !MustUseReg(rk.rmode())) {
+      // The literal goes in the command, whatever its size.
       addi_w(rd, rj, static_cast<int32_t>(rk.immediate()));
     } else {
       // li handles the relocation.
@@ -900,6 +901,8 @@ void MacroAssembler::Add_d(Register rd, Register rj, const Operand& rk) {
   } else {
