index c148a055ea..f29ad297c7 100644
--- a/chromium/v8/src/codegen/e2k/assembler-e2k.cc
+++ b/chromium/v8/src/codegen/e2k/assembler-e2k.cc
@@ -1256,6 +1256,10 @@ void Assembler::ffint_s_wr(FPURegister fd, Register rj) { LA(ffint_s_wr(fd, rj))
 void Assembler::beqz(Register rj, int32_t offset) { LA(beqz(rj, offset)); }
 void Assembler::bnez(Register rj, int32_t offset) { LA(bnez(rj, offset)); }
 void Assembler::jirl(Register rd, Register rj, int32_t offset) { LA(jirl(rd, rj, offset)); }
+void Assembler::addli_d(Register rd, Register rj, int64_t imm) { LA(addli_d(rd, rj, imm)); }
+void Assembler::andli(Register rd, Register rj, int64_t imm) { LA(andli(rd, rj, imm)); }
+void Assembler::orli(Register rd, Register rj, int64_t imm) { LA(orli(rd, rj, imm)); }
+void Assembler::xorli(Register rd, Register rj, int64_t imm) { LA(xorli(rd, rj, imm)); }
 void Assembler::bceqz(CFRegister cj, int32_t si21) { LA(bceqz(cj, si21)); }
 void Assembler::bcnez(CFRegister cj, int32_t si21) { LA(bcnez(cj, si21)); }
 void Assembler::add_w(Register rd, Register rj, Register rk) { LA(add_w(rd, rj, rk)); }
diff --git a/chromium/v8/src/codegen/e2k/assembler-e2k.h b/chromium/v8/src/codegen/e2k/assembler-e2k.h
index b27a3dd0f3..1628653543 100644
--- a/chromium/v8/src/codegen/e2k/assembler-e2k.h
+++ b/chromium/v8/src/codegen/e2k/assembler-e2k.h
@@ -537,6 +537,11 @@ class V8_EXPORT_PRIVATE Assembler : public AssemblerBase {
   }
 
   void jirl(Register rd, Register rj, int32_t offset);
+  // Not LoongArch: add, and, or, xor with a literal of any size.
+  void addli_d(Register rd, Register rj, int64_t imm);
+  void andli(Register rd, Register rj, int64_t imm);
+  void orli(Register rd, Register rj, int64_t imm);
+  void xorli(Register rd, Register rj, int64_t imm);
 
   void bceqz(CFRegister cj, int32_t si21);
   inline void bceqz(CFRegister cj, Label* L) {
diff --git a/chromium/v8/src/codegen/e2k/la_asm.h b/chromium/v8/src/codegen/e2k/la_asm.h
index 1c44117d76..4bbadda06b 100644
--- a/chromium/v8/src/codegen/e2k/la_asm.h
+++ b/chromium/v8/src/codegen/e2k/la_asm.h
@@ -405,6 +405,12 @@ class Assembler : private e2k::Assembler {
   void andn(Register rd, Register rj, Register rk) { alu(&E::andnd, rd, R(rj), R(rk)); }
   void orn(Register rd, Register rj, Register rk) { alu(&E::ornd, rd, R(rj), R(rk)); }
   void andi(Register rd, Register rj, int32_t ui12) { alu(&E::andd, rd, R(rj), ui12 & 0xfff); }
+  // Not LoongArch: the operation with a literal of any size (the command
+  // carries 32- and 64-bit literals), where LoongArch loads it first.
+  void addli_d(Register rd, Register rj, int64_t imm) { alu(&E::addd, rd, R(rj), imm); }
+  void andli(Register rd, Register rj, int64_t imm) { alu(&E::andd, rd, R(rj), imm); }
+  void orli(Register rd, Register rj, int64_t imm) { alu(&E::ord, rd, R(rj), imm); }
+  void xorli(Register rd, Register rj, int64_t imm) { alu(&E::xord, rd, R(rj), imm); }
   void ori(Register rd, Register rj, int32_t ui12) { alu(&E::ord, rd, R(rj), ui12 & 0xfff); }
   void xori(Register rd, Register rj, int32_t ui12) { alu(&E::xord, rd, R(rj), ui12 & 0xfff); }
 
