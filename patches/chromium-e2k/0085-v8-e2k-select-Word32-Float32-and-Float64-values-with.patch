+                     i.InputRegister(0), i.InputOperand(1), v_true, v_false);
+        return;
+      case kE2kFloat32Cmp:
+      case kE2kFloat64Cmp: {
+        bool predicate;
+        FlagsConditionToConditionCmpFPU(&predicate, condition);
+        if (predicate) {
