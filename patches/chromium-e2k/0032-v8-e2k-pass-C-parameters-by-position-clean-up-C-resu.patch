-  // in its result register. The results are therefore copied speculatively,
-  // and must not be requested from functions known to return nothing: the
-  // code that saves all caller-saved registers would trap on them.
-  void CallC(Register target, int num_gp, int num_fp, int num_results);
+  // in its result register, so the results are passed through memory by a
+  // speculative store, which turns such a value into a plain number.
+  void CallC(Register target, int fp_mask, int num_results);
+  // The whole body of a function called by C++ that jumps to the C++ function
+  // whose address is at [C parameter `arg` + offset], parameters untouched.
+  void TailCallC(int arg, int32_t offset);
   // rd = imm in one instruction whose value can be read and replaced
