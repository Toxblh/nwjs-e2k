diff --git a/chromium/v8/src/codegen/e2k/la_asm.h b/chromium/v8/src/codegen/e2k/la_asm.h
index 0cb28f071f..f323a1445d 100644
--- a/chromium/v8/src/codegen/e2k/la_asm.h
+++ b/chromium/v8/src/codegen/e2k/la_asm.h
@@ -180,38 +180,53 @@ class Assembler : private e2k::Assembler {
   }
   // Return to the C caller of enter() with the value of a0.
   void leave() { C(addd(0, R(a0), 0, e2k::r(0)); return_(e2k::ctpr3)); LF(ct(e2k::ctpr3)); }
-  // Call of the C function at `target` with ngp integer arguments in a0.. and
-  // then nfp floating point ones in f0..; the result comes back in a0 and f0
-  // (results >= 1) and a1 (results == 2).  The results are moved
-  // speculatively: a function that returns nothing leaves anything in its
-  // %r0, a diagnostic value too.  Such a value then sits in a0 and f0 until
-  // they are written; using it traps.  C parameters are the first eight registers of the callee whatever
-  // their type.  The callee's window starts at %b[4]: `call` raises SIGILL
-  // unless the caller's window ends at most 8 registers above that start, so
-  // the argument area is the top of the window (measured: wsz - wbs <= 4).  The hardware
-  // stack pointer is first set to 64 bytes below sp (the callee owns that
-  // area), so C frames go right under the frames of this code. It is moved up
-  // as well as down: C++ measures its stack depth by it, and left low after a
-  // deep recursion it would make V8 report stack overflows.  Every register of the layer survives the call.
-  // ponytail: integer arguments first, then floating point ones; a C function
-  // that mixes them in another order needs the real signature here.
-  void ccall(Register target, int ngp, int nfp, int results) {
-    assert(ngp >= 0 && nfp >= 0 && ngp + nfp <= 8 && results >= 0 && results <= 2);
+  // Call of the C function at `target`.  C parameters are the first eight
+  // registers of the callee whatever their type (the ninth and further ones
+  // are on the stack at sp): parameter i is taken from f<i> if bit i of
+  // fp_mask is set, from a<i> otherwise.  The result comes back in a0 and f0
+  // (results >= 1) and a1 (results == 2).
+  // A function that returns nothing leaves anything in its %r0, a diagnostic
+  // value (of a failed speculative operation) too, and any non-speculative use
+  // of one is SIGILL.  So the results go through memory: a speculative store
+  // writes a diagnostic value as plain bits and does not trap (measured), and
+  // what is loaded back is an ordinary number.
+  // The callee's window starts at %b[4]: `call` raises SIGILL unless the
+  // caller's window ends at most 8 registers above that start, so the
+  // argument area is the top of the window (measured: wsz - wbs <= 4).  The
+  // hardware stack pointer is first set to 64 bytes below sp (the callee owns
+  // that area), so C frames go right under the frames of this code.  It is
+  // moved up as well as down: C++ measures its stack depth by it, and left low
+  // after a deep recursion it would make V8 report stack overflows.  Every
+  // register of the layer survives the call.
+  void ccall(Register target, int fp_mask, int results) {
+    assert(fp_mask >= 0 && fp_mask < 256 && results >= 0 && results <= 2);
     C(rrd(0, Sreg::usd_lo, T0));
     C(andd(0, T0, 0xffffffffffffll, T0));        // usd.base
     C(subd(0, R(sp), T0, T0));
     C(subd(0, T0, 64, T0));
     C(andd(0, T0, -16, T0));                     // down to sp - 64, or back up to it
     C(getsp(0, T0, T1));
-    auto arg = [&](int i) { return i >= ngp && i < ngp + nfp ? e2k::r(32 + i - ngp) : e2k::r(4 + i); };
+    auto arg = [&](int i) { return fp_mask >> i & 1 ? e2k::r(32 + i) : e2k::r(4 + i); };
     C(for (int i = 0; i < 6; i++) addd(i, arg(i), 0, e2k::b(4 + i)));
     C(movtd(R(target), e2k::ctpr1); addd(1, arg(6), 0, e2k::b(10)); addd(2, arg(7), 0, e2k::b(11)));
     C(call(e2k::ctpr1, kWindow - 4));
+    if (results >= 1) C(std_(2, R(sp), -8, e2k::b(4)); sm(2); if (results == 2) { std_(5, R(sp), -16, e2k::b(5)); sm(5); });
     cmd();
-    if (results >= 1) { addd(0, e2k::b(4), 0, R(a0)); sm(0); addd(2, e2k::b(4), 0, e2k::r(32)); sm(2); }
-    if (results == 2) { addd(1, e2k::b(5), 0, R(a1)); sm(1); }
+    if (results >= 1) { ldd(0, R(sp), -8, R(a0)); ldd(2, R(sp), -8, e2k::r(32)); }
+    if (results == 2) ldd(3, R(sp), -16, R(a1));
     finish();
   }
+  // The whole body of a function called by C that does nothing but jump to
+  // the C function whose address is at [parameter `arg` + offset]: the
+  // parameters and the window stay as they are, the callee returns to our
+  // caller.  %g16 is a scratch register of the C ABI (lcc computes in
+  // %g16.. in leaf functions).
+  void tail_c(int arg, int32_t offset) {
+    assert(arg >= 0 && arg < 8);
+    C(ldd(0, e2k::r(arg), offset, e2k::g(16)));
+    C(movtd(e2k::g(16), e2k::ctpr1));
+    LF(ct(e2k::ctpr1));
+  }
   // rd = a 64-bit value that can be read back and replaced (li64_at).
   void li64(Register rd, int64_t value) { L(addd(0, 0, e2k::Src2::lit64(value), D(rd))); }
 
