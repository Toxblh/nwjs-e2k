diff --git a/chromium/v8/src/codegen/e2k/assembler-e2k.h b/chromium/v8/src/codegen/e2k/assembler-e2k.h
index f87ef7de7b..867733096d 100644
--- a/chromium/v8/src/codegen/e2k/assembler-e2k.h
+++ b/chromium/v8/src/codegen/e2k/assembler-e2k.h
@@ -374,19 +374,22 @@ class V8_EXPORT_PRIVATE Assembler : public AssemblerBase {
   void EnterFromC(int num_args);
   // Returns to the C++ caller of EnterFromC() with the value of a0.
   void ReturnToC();
-  // Calls the C function at `target`: num_gp integer arguments from a0..,
-  // then num_fp floating point ones from f0... With num_results >= 1 the
-  // result is copied to a0 and f0, with 2 also to a1. All other registers
-  // survive the call (the callee has its own window). Execution continues at
-  // the next instruction.
+  // Calls the C function at `target`. C parameters are positional whatever
+  // their type: parameter i < 8 is taken from f<i> if bit i of fp_mask is
+  // set, from a<i> otherwise; further ones are on the stack at sp. With
+  // num_results >= 1 the result is copied to a0 and f0, with 2 also to a1.
+  // All other registers survive the call (the callee has its own window).
+  // Execution continues at the next instruction.
   //
   // On e2k a register may hold a "diagnostic" value, the result of a failed
   // speculative operation; using it in any non-speculative operation, a store
