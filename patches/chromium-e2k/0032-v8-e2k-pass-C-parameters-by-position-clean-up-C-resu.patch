--- a/chromium/v8/src/compiler/backend/instruction-codes.h
+++ b/chromium/v8/src/compiler/backend/instruction-codes.h
@@ -497,6 +497,14 @@ using BranchHintField = StackCheckField::Next<bool, 1>;
 // operand.
 using ParamField = base::BitField<int, 0, 5>;
 using FPParamField = ParamField::Next<int, 5>;
