 // Assembles branches after an instruction.
 void CodeGenerator::AssembleArchBranch(Instruction* instr, BranchInfo* branch) {
   Label* tlabel = branch->true_label;
@@ -4733,7 +4777,8 @@ void CodeGenerator::AssembleArchBranch(Instruction* instr, BranchInfo* branch) {
     RpoNumber target = i.InputRpo(instr->InputCount() - k);
     if (GetLabel(target) == tlabel) {
       rare = instructions()->InstructionBlockAt(target)->IsDeferred() &&
-             !instructions()->InstructionBlockAt(current_block_)->IsDeferred();
+             !instructions()->InstructionBlockAt(current_block_)->IsDeferred() &&
+             DeferredTargetIsRare(instructions(), target);
     }
   }
