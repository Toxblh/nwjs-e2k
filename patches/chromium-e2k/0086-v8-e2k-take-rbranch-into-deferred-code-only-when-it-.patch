+namespace {
+
+// Whether a branch into deferred code is rare. Deferred is a layout hint (CSA
+// labels, branch hints) and not a frequency: deferred code that calls (the
+// runtime, a builtin, a stub) is a slow path, but deferred code that only
+// computes and goes back to ordinary code (the Smi case of
+// ToBooleanForBaselineJump) may be taken often, and a taken rbranch costs 14
+// cycles against 6 of an ordinary branch (la/NOTES.md). The deferred blocks
+// reachable from the target are looked at, up to a bound past which the path
+// counts as a slow one.
+bool DeferredTargetIsRare(const InstructionSequence* code, RpoNumber target) {
+  constexpr int kMaxBlocks = 16;
+  RpoNumber work[kMaxBlocks];
+  int count = 0, done = 0;
+  work[count++] = target;
+  while (done < count) {
+    const InstructionBlock* block = code->InstructionBlockAt(work[done++]);
+    if (!block->IsDeferred()) continue;
+    for (int i = block->code_start(); i < block->code_end(); i++) {
+      const Instruction* instr = code->InstructionAt(i);
+      if (instr->IsCall() || instr->IsDeoptimizeCall() ||
+          instr->arch_opcode() == kArchDeoptimize ||
+          instr->arch_opcode() == kArchAbortCSADcheck ||
+          instr->arch_opcode() == kArchDebugBreak ||
+          instr->arch_opcode() == kArchTailCallCodeObject ||
+          instr->arch_opcode() == kArchTailCallAddress ||
+          instr->arch_opcode() == kArchStoreWithWriteBarrier ||
+          instr->arch_opcode() == kArchTruncateDoubleToI) {
+        return true;
+      }
+    }
+    for (RpoNumber succ : block->successors()) {
+      bool seen = false;
+      for (int k = 0; k < count; k++) seen |= work[k] == succ;
+      if (seen) continue;
+      if (count == kMaxBlocks) return true;
+      work[count++] = succ;
+    }
+  }
+  return false;
+}
+
+}  // namespace
